"./ch04_stmt.tie", "./ch05_func.tie", "./ch06_data.tie", "./ch07_port.tie", "./ch08_error.tie", "./ch09_module.tie", "./ch10_conc.tie", "./ch11_unsafe.tie", "./ch12_macro.tie", "./ch13_move.tie", "./ch14_ui.tie", "./ch15_tool.tie", "./ch16_ref.tie", "./ch17_spec.tie", "void", "/std/result.tie", "/std/prelude.tie", "list_dir", "walk_dir", "byte_read", "byte_concat", "regex_find_all", "stdin_read", "F:/Projects/tie-repo/tie-spec/source/20262/pdfdoc.tie", "\"../../../tofflib/pdf.tie\"", "DP_W", "DP_H", "DP_ML", "72", "DP_MR", "DP_MT", "68", "DP_MB", "62", "DP_COLW", "451", "DP_BOTTOM", "SZ_H1", "18", "SZ_H2", "13", "SZ_H3", "11", "SZ_BODY", "10", "SZ_CODE", "9", "SZ_TBL", "SZ_PAGE", "8", "LH_BODY", "16", "LH_CODE", "LH_TBL", "14", "F_BODY", "\"C:/Windows/Fonts/NotoSansSC-VF.ttf\"", "F_MONO", "\"fonts/JetBrainsMono-Regular.ttf\"", "SLOT_BODY", "SLOT_MONO", "HL_PLAIN", "HL_COMMENT", "HL_STRING", "2", "HL_NUMBER", "3", "HL_KEYWORD", "4", "HL_TYPE", "5", "HL_FUNC", "6", "dp_page", "dp_y", "dp_collect", "g_toc_t", "table", "<", ">", "g_toc_l", "g_toc_p", "g_toc_off", "g_dots", "\"\"", "namespace", "docp", "cpw", "slot", "fb", "cp", "w", "pdf", "cp_w1000", "&&", ">=", "*", "100", "/", "1000", "tw", "txt", "size", "shape_width", "shape", "put", "x", "y", "text_shaped", "putc", "hl", "r", "g", "b", "hl_rgb", "text_shaped_c", "128", "163", "21", "122", "157", "51", "179", "26", "127", "142", "121", "94", "38", "30", "pub", "font_init", "rc0", "font_load", "!=", "\"[pdfdoc] 错误：\"", "load_err_text", "rc1", "str_len", "sb", "string_builder", "i", "while", "400", "sb_append", "\".\"", "sb_build", "begin_doc", "add_page", "-", "begin", "table_new_string", "table_new_i64", "len", "toc_title", "[", "]", "toc_level", "toc_pg", "n", "toc_offset", "cur_page", "toc_add", "title", "level", "table_push", "footer", "t", "34", "new_page", "need", "h", "gap", "chunks", "s", "out", "cur", "c", "str_char", "char_code", "32", "\" \"", "w_of", "wrap", "max_w", "lim", "lines", "cs", "cw", "sub", "c