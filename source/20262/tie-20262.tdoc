        ["h2", "16.9  字符串与数字"],
        ["code", "tie", "
\"普通字符串，花括号即字面量\"
h\"{插值}\" 花括号内求值
h\"{x:08.2f}\" 插值带格式说明符
r\"原始字符串无转义\"
\"\"\"多行字符串，按闭合引号缩进剥离\"\"\"
'A'                       // 字符

42  0xFF  0b1011  0o755  0t1T0      // 五种进制
1_000_000                           // 下划线分组
3.14  1.5e3                         // 浮点
42i32  0x80u16  1.5f32  0.1d        // 类型后缀
-1t  0t  1t                         // 三值
"],
        ["h2", "16.10  运算符速览"],
        ["code", "tie", "
a + b   a - b   a * b   a / b   a % b     // 算术；容器上 + 为拼接、* 为重复
a \\ b   a %% b                            // 整除与成对取余
a ** b   a **? b                          // 幂；带检查的幂
a +? b   a -? b   a *? b   a <<? b         // 带检查的算术与移位
a == b   a != b   a < b   a <= b          // 比较（可链式）
a in xs   a not in xs                     // 成员判定
v is T                                    // 类型判定（动态值，见 3.17）
cond && cond   cond || cond   !cond       // 逻辑
cond ? a : b                              // 条件运算（右结合）
a << b   a >> b   a & b   a | b   a ^ b   ~a   // 位运算（整数）
a | b   a & b   a - b   a ^ b            // 容器：并、交、差、对称差
x = v   x += v   x \\= v   x %%= v         // 赋值与复合赋值

[x * x for x in xs if c]   // 集合综合（见 3.18）

v -> f            // 管道
v -> [i]          // 管道进下标
v -> .field       // 管道进字段
v -> { x -> e }   // 块管道（x 为绑定名）
x <- v            // 反向赋值
t <- v            // 容器追加（返回自身，可链式）
(a, b) <- t       // 解构
v with { k: x }   // 不可变更新
opt ?   opt ?: d   obj?.f   obj?[i]        // 可空链
xs[1..3]   xs[..2]   xs[2..]   xs[..]      // 切片
await f                                    // 延后取得异步结果（见 10.6）
\\p                                        // 解引用（不安全）
"],
        ["h2", "16.11  语句速览"],
        ["code", "tie", "
if c { } else if c2 { } else { }
var x = if c { a } else { b }              // 条件取值（见 4.13）
if let Some(v) = opt { }
while c { }
for i in 0..n { }
for x in xs { }
for c in s.chars() { }
lbl: for i in 0..n { break lbl }
switch v { case 1: ... default: ... }
var x = switch v { 0 -> a, _ -> b }        // 分支即表达式
var (a, b) = pair
var (a, ...rest) = xs
guard c else { return }
defer { cleanup() }
try { x = f()? }
return v    yield v    break    continue
panic(\"msg\")
unsafe goto #tag                            // 配 #[tag.tag] 标签
unsafe { }                                  // 不安全块
"],
        ["h2", "16.12  声明速览"],
        ["code", "tie", "
[pub] [unsafe] [async] [inline] func f(a: i64) -> i64 { }
func f(x: i64) -> i64 = x * 2               // 等号体
struct S<T> extends B { var f: T = d; }
enum E { A  B(x: i64) }
namespace ns { }
port P { pub func m(self) -> i64 }          // 名义接口
interface I { pub func m(self) -> i64 }     // 结构接口
impl P for S { pub func m(self) -> i64 { } }
actor A { var n: i64 = 0;  pub func m() { } }
macro m(x: code) -> code { }
alias M = table<f64>
extern func e(a: i64) -> i64
import \"m.tie\" as m
import \"m.tie\".{ a, b }                     // 选择性导入
pub import \"m.tie\"                          // 重导出
using ns.sub
var g: table<i64> = []
const K: i64 = 10
@注解(3)  #[属性]  #cfg(cond)               // 注解与条件编译
view V(p: i64) -> (Act) { @Column { } }     // 界面单元
"],
        ["h2", "16.13  形式与分工"],
        ["p", "把全书反复出现的判断收束成一张对照：遇到「这个信息该写在哪」，查这张表。"],
        ["tblw",
            ["要表达的意思", "写在哪"],
