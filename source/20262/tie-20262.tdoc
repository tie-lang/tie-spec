println(s)              // 输出一行
len(t)                  // 元素数或字节数
to_string(v)            // 转文本（自由函数：接收者不限类型）
len(s)  str_char(s, i)  // 码点数；取第 i 个码点
str.trim(s)  str.split(s, sep)  str.join(xs, sep)  str.contains(s, sub)
seq_sort(t)  seq_reverse(t)  seq_distinct(t)   // 集合操作（见 2.20）
seq_group_by(key, t)  tbl_cat(a, b)           // 分组与拼接
iter_map(f, xs)  iter_filter(p, xs)  // 迭代器适配（见 6.11）
iter_take(n, xs)  iter_zip(a, b)  iter_chain(a, b)
r.wrap_err(msg)  e.cause()  e.root_cause()   // 错误链（见 8.7）
Ok(v)  Err(e)  Some(v)  None           // 构造名默认可见（见 9.4）
file_read(p)  file_write(p, s)
byte_read(p)  byte_write(p, t)   // 二进制安全
load_library(n)  get_proc(h, n)  dyn_call(p, ...)
"],
