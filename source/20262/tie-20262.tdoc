               为空」这条常见路径不必层层写分支。"],
        ["tblw",
            ["记号", "语义"],
            ["expr ?", "取出 Option 内的值；为 None 则立即从当前函数返回（错误向上传播）。"],
            ["expr ?: 默认值", "取出 Option 内的值；为 None 则用右侧表达式。右侧只在缺失时求值。"],
            ["opt ?. 字段", "在可空值上取字段；为 None 则整体为 None，不继续求值。"],
            ["opt ?. 方法()", "在可空值上调用方法；同上。"],
            ["opt ?[ 下标 ]", "在可空值上取下标；为 None 或越界则整体为 None。"],
            [3000, 6020]],
        ["code", "tie", "
var port = opt_port ?: 8080             // None 则取默认
