        ["p", "把「此处发生了指针访问」写进表达式，使审计内存访问时可以在文本层面搜索，而不必追踪函数调\
               用的实现。"],
        ["h2", "3.16  范围与切片"],
        ["p", "范围用两个点表示，左闭右开；带等号的形式包含右端点。范围用于循环、分支匹配与切片。"],
        ["code", "tie", "
for i in 0..10 { }      // 0 到 9
for i in 0..=10 { }     // 0 到 10
var head = xs[0..3]      // 前三个元素
var rest = xs[3..]       // 从第四个到尾
var upto = xs[..2]       // 前两个元素
var all = xs[..]         // 整个表
"],
        ["p", "切片的三段形式（只给起点、只给终点、两端都省）使「取头部」「取尾部」「取全部」都有最短写\
               法，不必写出冗长的边界表达式。"],
        ["p", "下标可以是任意整数类型，宽度不影响语义，超出该类型表示范围的常量下标在编译期即被拒绝。负\
               下标按越界处理——语言不从尾部计数，因此 t[-1] \
               不会取到末元素，而是与「取到了不存在的位」同样报告。这样下标只有一种读法，读者不必先判断\
               「这个负数在这里是索引还是偏移」。"],
        ["p", "读越界与除零同属内建检查（见 8.5）：报告源码位置、下标与长度，并沿统一的失败路径处理——在\
               捕获域内可被接住，域外终止进程。切片端点越界则不同，按边界截断，因为「取到尽头」在切片里\
               是常见且明确的意图。"],
        ["p", "写越界不报错：往末尾之外写会按需扩展容量。值语义下这次写入先复制一份再扩展，因此有别名的\
               一方保持原长度，写入者得到一个更长的表（见 13.5）。"],
        ["h2", "3.17  类型判定"],
        ["p", "类型判定用于询问一个动态类型值的实际类型，配合分支使用，使分支内的取用是安全的。"],
        ["code", "tie", "
var v: any = 42
if v is i64 {
    var n = as_i64(v)
}
"],
        ["p", "判定与转换分开书写，而不是在判定中隐式完成转换。这样每一处的类型假设都是显式的，阅读时不\
               必回推。"],
        ["h2", "3.18  集合综合"],
        ["p", "综合表达式从一个可遍历的值直接构造新表：方括号内写「元素表达式 for 元素 in \
               来源」，可选地跟一个筛选条件。变换、筛选、收集在一次书写里完成，与遍历语句同构——会写 \
               for 就会写综合。"],
        ["code", "tie", "
var squares = [x * x for x in 0..10]
var big = [x for x in xs if x > 100]
var names = [u.name for u in users if u.active]
"],
        ["p", "综合是普通表达式，可以出现在任何值的位置，也可以嵌套。来源可以是表、映射的键值对、范围，\
               或一切满足遍历约定的类型（见 6.10）。"],
        ["code", "tie", "
var pairs = [(k, v) for k in cfg]
var flat = [x for row in grid for x in row]   // 嵌套展平
"],
        ["p", "综合立即求值，产出实体表；需要在链中懒式逐元素流动的场合，用迭代器适配（见 \
               6.11）。二者分工：综合负责「一口气造出来」，适配负责「边走边算」。需要映射形态的结果时，\
               对综合结果施加映射转换内建，或直接用键值字面量书写。"],
        ["note", "综合与管道是同一件事的两种入口：日常一行能写完的变换用综合；步骤多、需要复用中间名或作用\
                  于无限序列时用管道链。语言不比较二者的优劣，按场合选用。"],

        // ===== 第 4 章  语句 =====
        ["h1", "第 4 章  语句"],
        ["p", "语句描述控制流与状态的改变。本章逐一说明各类语句，并给出它们在书写上的一致做法。语句之间\
               以自动分号分隔（见 1.10），因此不必为每行补分号，也不应依赖缩进决定结构。"],
        ["h2", "4.1  变量声明"],
        ["p", "变量用 var 声明，常量用 const 声明。常量必须在声明处确定取值，此后不可重新绑定。"],
        ["code", "tie", "
var count = 0
var name: string = \"tie\"
const MAX = 1024
"],
        ["h3", "作用域"],
        ["p", "变量在所在块内可见，块结束时消失。内层块可以声明与外层同名的变量，此时内层遮蔽外层；编译\
               器对遮蔽给出提示，因为它常是笔误。"],
        ["p", "函数参数与函数体的局部变量处于同一作用域。闭包可以读取其外层函数的变量，规则见第 5 章。"],
        ["h3", "全局变量的求值时机"],
        ["p", "全局变量的初值在程序入口求值。声明前可以加求值时机前缀：lazy 表示推迟到第一次读取时\
               求值，并且只求值一次；eager 表示把入口求值这一默认行为显式写出。不加前缀的 var 声明\
               始终有效，三个方向都可用。"],
        ["code", "tie", "
var a: i64 = 7
lazy var b: i64 = compute()
eager var c: i64 = compute()
"],
        ["p", "lazy 与 eager 是上下文关键字，只在紧邻变量声明时承担修饰作用；在其他位置它们仍是普通\
               标识符，可以继续作变量名、参数名与函数名。"],
        ["p", "求值时机前缀适用于数值、布尔、字符、三值、文本、结构、枚举与表。映射、端口、函数值、\
               动态类型等不具备对应的惰性物化语义，声明时由编译期拒绝。表的初值必须写成表字面量。"],
        ["p", "初值直接或间接引用自身构成循环初始化。初始化过程区分「未初始化」「初始化中」「已完成」\
               三态，重入「初始化中」即报告循环初始化并终止，不产生未定义的值。先写入后读取视为已完成，\
               不再触发初值求值。"],
        ["p", "表全局的初值为空或省略时，得到的是长度为零的真实表句柄，不是空指针句柄。空表可以安全\
               地读取长度、参与比较与遍历。"],
        ["h2", "4.2  赋值"],
        ["p", "赋值把右侧的值写入左侧的目标。复合赋值形式把运算与写入合并。"],
        ["code", "tie", "
count = 10
count += 1        // 自增
count *= 2        // 倍增
count %%= 5       // 原地取余并写回
"],
        ["p", "赋值目标的类型与右侧表达式必须相容。语言不做隐式的窄化转换，需要窄化时显式书写转换。"],
        ["h2", "4.3  条件分支"],
        ["p", "if 接受一个布尔表达式。else if 串接多个条件，else 收尾。条件必须严格是 \
               bool——语言不接受用整数代表真伪，这排除了把赋值误写成比较的一类错误。"],
        ["code", "tie", "
if score >= 90 {
    grade = \"A\"
} else if score >= 60 {
    grade = \"B\"
} else {
    grade = \"C\"
}
"],
        ["p", "本节的 if 是语句：分支描述「做什么」，不产出值。条件取值（if 也可以是一个表达式）见 \
               4.13；单行紧凑的条件取值用条件运算（见 3.14）。"],
        ["h2", "4.4  循环"],
        ["p", "循环有三种形态：条件循环、范围循环、集合循环。三者覆盖了绝大多数遍历需求，因此不需要通用\
               的三段式循环语句。"],
        ["code", "tie", "
while running {
    step()
}

for i in 0..10 {
    println(to_string(i))
}

for item in items {
    handle(item)
}
"],
        ["p", "遍历文本使用码点迭代，这样多字节字符不会被切断："],
        ["code", "tie", "
for ch in text.chars() {
    // ch 是一个完整字符
}
"],
        ["h3", "循环标签"],
        ["p", "嵌套循环中，若需要从内层直接跳出到外层之外，用标签指明目标。标签写在循环语句之前。"],
        ["code", "tie", "
outer: for a in 0..10 {
    for b in 0..10 {
        if b == 5 { break outer }
        if b == 2 { continue outer }
    }
}
"],
        ["p", "无标签的 break 与 continue 作用于最近一层循环。带标签的跳转在编译期校验目标存在，标签未\
               匹配即报错。"],
        ["h2", "4.5  多分支选择"],
        ["p", "switch 按值分派到若干分支。每个分支自动结束，不存在落入下一分支的情况，因此不需要 \
               break。"],
        ["code", "tie", "
switch code {
    case 1, 2:
        println(\"小\")
    case 3..7:
        println(\"中\")
    default:
        println(\"其他\")
}
"],
        ["p", "分支可以匹配枚举并同时取出其携带的数据，此时编译器要求所有分支被覆盖，遗漏即报错。这是把\
               「几种情况之一」的数据处理写完整的主要手段。"],
        ["code", "tie", "
switch shape {
    case Shape.Circle(r):
        println(to_string(r))
    case Shape.Rect(w, h):
        println(to_string(w * h))
}
"],
        ["h2", "4.6  跳转"],
        ["p", "return 结束当前函数并带回值；yield 在生成器中产出一个值并继续执行；panic \
               报告不可恢复的错误并终止当前执行流（见第 8 章）。"],
        ["code", "tie", "
func pick(xs: table<i64>) -> i64 {
    for x in xs {
        if x > 0 { return x }
    }
    return 0
}

func counter(n: i64) -> i64 {
    for i in 0..n {
        yield i
    }
}
"],
        ["p", "goto 在需要把多层嵌套的清理路径收敛到一处时使用。它只允许在同一个函数内跳转，且不允许跳\
               入循环或分支的内部——这两条限制使它不会破坏块作用域。"],
        ["code", "tie", "
func transfer() -> i64 {
    if open_a() != 0 { unsafe goto #done }
    if open_b() != 0 { unsafe goto #after_b }
    // ...
    #[tag.after_b]
    close_b()
    #[tag.done]
    close_a()
    return 0
}
"],
        ["h2", "4.7  表达式语句"],
        ["p", "一个表达式后面接语句结束，构成表达式语句。它用于调用有副作用的函数。"],
        ["code", "tie", "
println(\"hello\")
items -> sort -> print_all
"],
        ["p", "没有副作用的表达式语句通常意味着书写疏漏，编译器会对此给出提示。"],
        ["h2", "4.8  条件解构"],
        ["p", "当条件涉及「取值可能失败」的类型时，条件与解构可以合并书写：匹配成功则进入分支并取出内部\
               值，失败则走另一支。"],
        ["code", "tie", "
if let Some(v) = find(xs, target) {
    println(\"找到 \" + to_string(v))
} else {
    println(\"未找到\")
}
"],
        ["p", "这一形式省去了「先判断、再取值」的两步写法，并保证取值只在匹配成立的路径上发生——判断与取\
               值之间不存在状态变化的窗口。"],
        ["h2", "4.9  前置条件"],
        ["p", "guard 在函数开头声明「必须满足什么才能继续」。条件不成立时执行给定的收尾块（通常是返回或\
               报错），成立则继续往下走。"],
        ["code", "tie", "
func transfer(from: string, amount: i64) -> bool {
    guard amount > 0 else { return false }
    guard from != \"\" else { return false }
    // 走到这里，两个条件都已成立
    return true
}
"],
        ["p", "与 if 的差别在阅读顺序：guard 把前置条件与随后的正常流程分开，使正常路径保持在同一缩进层\
               级，不必层层深入。收尾块必须以跳转语句结束（返回、报错或跳出），否则条件不成立时无法离开\
               当前流程。"],
        ["h2", "4.10  作用域收尾"],
        ["p", "defer 登记一段在离开当前作用域时执行的代码。多段收尾按登记的逆序执行，因此「先申请后释放\
               」的对应关系自然成立。"],
        ["code", "tie", "
func process(path: string) {
    var h = open(path)
    defer { close(h) }
    var buf = acquire()
    defer { release(buf) }
    // 离开作用域时：先 release(buf)，再 close(h)
    use(h, buf)
}
"],
        ["p", "把释放写在申请的下一行，是这一记号的主要用法：申请与释放成对出现在同一屏内，中间无论有多\
               少条提前返回的路径，都不会漏掉释放。"],
        ["h2", "4.11  错误聚合块"],
        ["p", "一段代码中若有多处可能失败的操作，可以把它们放进一个块内统一处理：块内每个可能失败的操作\
               后面写传播记号，块本身可以取到最后一个表达式的值。"],
        ["code", "tie", "
var total = try {
    var a = read_first() ?
    var b = read_second() ?
    a + b
}
"],
        ["h2", "4.12  跳转与标签"],
        ["p", "在需要把多层嵌套的清理路径收敛到一处时使用跳转。标签声明某处可以被跳转抵达，跳转语句引用\
               该标签。"],
        ["code", "tie", "
func retry_read() -> i64 {
    #[tag.retry]
    var r = read()
    if r == 0 { unsafe goto #retry }   // 回到同一块的开头重试
    #[tag.done]
    return finish(r)
}
"],
        ["p", "跳转受三条限制：只能在同一函数内跳转；只能跳到同一块或已经执行过的外层块；不得跳过变量初\
               始化进入其作用域。这三条共同保证跳转不会破坏作用域的有效性。跳转属不安全操作，需要显式标\
               注。"],
        ["h2", "4.13  分支即表达式"],
        ["p", "多分支不仅可以作语句，也可以作表达式：每个分支给出一个值，整个分支结构即具有该值。它使「\
               按情形取值」不必先声明变量再逐个赋值。"],
        ["code", "tie", "
var label = switch n {
    0 -> \"零\",
    1..9 -> \"个位\",
    _ -> \"多位\",
}
"],
        ["p", "作表达式时分枝用箭头书写，分支之间以逗号分隔；分支必须穷尽，未覆盖的情形由通配分支承接。\
               作语句时分支用冒号书写，形态见 4.5。"],
        ["p", "双分支的条件取值有更直接的形式：if 表达式。条件成立时取前一臂的值，否则取 else \
               臂的值，未成立的臂不会被求值。else 不可以省略——表达式在任何情形下都必须有一个值；允许省\
               略 else 的条件分支是语句，形态见 4.3。条件同样必须是 bool。"],
        ["code", "tie", "
var fee = if count > 0 { base * count } else { base }
"],
        ["p", "两臂取值的类型须一致；同为整数族或浮点族时允许混写，统一到较宽的一方，其余情形要求完全一\
               致。条件多于两个时用 else if 串接，按书写顺序判定，取第一个成立分支的值。if 表达式与 \
               switch 表达式互补：各条件彼此独立时用 if，对同一对象按取值分派时用 switch。"],
        ["h2", "4.14  解构"],
        ["p", "把复合值的各分量一次绑定到多个名字，称为解构。语言在四种位置支持解构，形态一致。"],
        ["tblw",
            ["位置", "写法"],
            ["声明", "var (a, b) = pair"],
            ["声明（剩余）", "var (a, ...rest) = xs"],
            ["遍历", "for (k, v) in pairs { }"],
            ["赋值", "(a, b) <- pair"],
            [3000, 6020]],
        ["p", "剩余形态把未被列举的尾部收进一个表，用于「取头部若干项、其余整体处理」的场合。"],

        // ===== 第 5 章  函数 =====
        ["h1", "第 5 章  函数"],
        ["p", "函数是行为的单位。本章说明函数的定义与调用形态，并重点说明参数——参数是调用方与被调方之间\
               的契约，写好参数规则，函数的行为边界就清楚了一半。"],
        ["h2", "5.1  定义与调用"],
        ["p", "函数定义给出名称、参数与返回类型；返回类型不可省略。函数体是语句块，最后一条语句通常是 \
               return。"],
        ["code", "tie", "
func add(a: i64, b: i64) -> i64 {
    return a + b
}

var s = add(1, 2)
"],
        ["p", "对外可见的函数标注 pub。可见性同时受模块与命名空间约束（见第 9 章）。"],
        ["h2", "5.2  参数传递约定"],
        ["p", "参数的传递约定写在参数名的位置，共四种：按值、可写借用、只读借用、所有权转移。约定是声明\
               的一部分，调用方不需要也无法改变它。"],
        ["tblw",
            ["形态", "语义"],
            ["x: T", "按值。被调方得到一份副本，改动不影响调用方。默认约定。"],
            ["ref x: T", "可写借用。被调方就地读写调用方的对象，改动对调用方可见。"],
            ["immut x: T", "只读借用。被调方只能读取，不能写入；用于避免大对象的复制开销。"],
            ["move x: T", "所有权转移。实参的所有权移交被调方，调用方此后不得再使用该变量。"],
            [2800, 6220]],
        ["code", "tie", "
func by_value(x: i64) -> i64 { return x }
func by_ref(ref t: table<i64>) -> i64 { t <- 1; return len(t) }
func by_read(immut t: table<i64>) -> i64 { return len(t) }
func by_move(move t: table<i64>) -> i64 { return len(t) }
"],
        ["h3", "约定的互斥与组合"],
        ["p", "可写借用与只读借用互斥：同一个参数不能既允许写又声明只写。所有权转移与两者也互斥：所有权\
               已经交出，无从借用。同一个修饰重复书写视为笔误，编译器报告错误。"],
        ["note", "四种约定是互斥的完备划分——每个参数恰好属于其中一种。这一设计使得阅读函数签名即可知道它对\
                  实参做了什么，不需要查看函数体。"],
        ["h3", "可写借用的限制"],
        ["p", "可写借用要求实参是可寻址的对象（变量、字段、表元素），而不是临时值。这样「改动会写回」这\
               一承诺才有着落。字面量与调用结果不能作为可写借用的实参。"],
        ["h3", "所有权转移后的使用"],
        ["p", "实参被移出后，调用方再使用该变量会被检出。这条检查在移动语义检查阶段执行，覆盖直接使用与\
               间接使用。"],
        ["code", "tie", "
var data: table<i64> = []
data <- 1
var n = by_move(data)
println(to_string(len(data)))   // 错误：变量已移出
"],
        ["h2", "5.3  默认参数"],
        ["p", "参数可以带默认值。带默认值的参数必须连续排在参数表末尾，因此调用方只需按顺序给出前面的实\
               参。"],
        ["code", "tie", "
func connect(host: string, port_no: i64 = 8080, timeout: i64 = 30) -> i64 {
    // ...
    return 0
}

connect(\"localhost\")            // port_no 与 timeout 取默认
connect(\"localhost\", 9090)      // timeout 取默认
connect(\"localhost\", 9090, 60)  // 全部给定
"],
        ["p", "默认值在编译期确定，因此它必须是常量表达式——不含副作用，也不依赖调用点的作用域。这一限制\
               使得默认值可以安全地在多个调用点之间共享。"],
        ["p", "可写借用与所有权转移的参数不带默认值：借用需要一个真实对象，所有权转移需要一个真实来源，\
               两者都无法凭空构造。"],
        ["h2", "5.4  命名实参"],
        ["p", "调用时可以按参数名指定实参。命名实参写在位置实参之后，可以乱序。这样做的好处是调用点自解\
               释——不必回看函数定义即可知道每个值对应什么。"],
        ["code", "tie", "
connect(host: \"localhost\", timeout: 60)
connect(\"localhost\", timeout: 60)
"],
        ["p", "命名实参可以跳过中间带默认值的参数。上例第二个调用中 port_no \
               未给出，取默认值。这一规则与默认参数「连续居尾」的约定配合，使得「只改其中一项」的调用写\
               起来最短。"],
        ["p", "调用形式的三条规则：位置实参在前、命名实参在后；同一个参数不得被指定两次；命名不得与已被\
               位置实参占用的参数冲突。违反任一条即报错，并指明具体位置。"],
        ["h3", "与方法的一致性"],
        ["p", "方法调用（见第 6 章）的命名实参与默认参数规则与函数完全一致。接收者不参与命名——它由调用\
               对象给出，也不能被默认值补齐。"],
        ["h2", "5.5  变长参数"],
        ["p", "参数表末尾可声明变长参数，接收零个或多个同类型实参。变长参数不带默认值，也不能是借用。"],
        ["code", "tie", "
func sum(rest: ...i64) -> i64 {
    var total = 0
    for x in rest {
        total += x
    }
    return total
}

sum()
sum(1, 2, 3)
"],
        ["p", "调用时可用展开记号把一个表摊开成实参序列（见 5.14）。"],
        ["h2", "5.6  返回值"],
        ["p", "函数可以返回多个值，返回类型写成元组。调用方解构接收。"],
        ["code", "tie", "
func divmod(a: i64, b: i64) -> (q: i64, r: i64) {
    return (a / b, a % b)
}

var (q, r) = divmod(7, 3)
"],
        ["p", "元组分量的名称是可选的，但推荐书写：它同时作为调用点的解构依据与文档。"],
        ["h2", "5.7  一等函数"],
        ["p", "函数可以作为值传递、返回与存放。函数类型的写法是 fn(参数类型...) -> 返回类型。"],
        ["code", "tie", "
func apply(g: fn(i64) -> i64, v: i64) -> i64 {
    return g(v)
}

func twice(g: fn(i64) -> i64, x: i64) -> i64 {
    return g(g(x))
}
"],
        ["p", "具名函数可直接用作函数值，不需要额外的取地址或包装。"],
        ["h2", "5.8  闭包"],
        ["p", "闭包是携带环境的函数值。它由函数字面量产生，可以读取其定义处的变量。"],
        ["code", "tie", "
var base = 100
var bump: fn(i64) -> i64 = func(t) -> i64 { return t + base }
println(to_string(bump(1)))   // 101
"],
        ["p", "闭包字面量的参数类型在上下文给出函数类型时可以省略，由上下文补齐。没有上下文时报错，而不\
               是猜测一个类型。"],
        ["h2", "5.9  短闭包"],
        ["p", "单参数、单表达式的闭包可以写成短形式：参数名、箭头、表达式。"],
        ["code", "tie", "
var f: fn(i64) -> i64 = t -> t + 1
var g: fn(i64) -> i64 = n -> n * n + 1
"],
        ["p", "短闭包可用在声明位置（标注给出类型）与赋值位置（目标类型在语义分析时已知）。这两种位置都\
               要求一个函数值，因此箭头两侧的解释是确定的。完整形态与短形态可以混用，二者语义相同。"],
        ["h2", "5.10  捕获面"],
        ["p", "闭包能捕获什么，由捕获面白名单规定。这条规则的目的很具体：保证逃逸出定义处的闭包不会持有\
               已经失效的引用。"],
        ["tblw",
            ["可捕获", "说明"],
            ["外围的按值参数", "标量、结构与枚举捕获值快照；表与映射按引用捕获"],
            ["外围的只读借用参数", "同上；且不可写回"],
            ["外围的局部变量", "同按值参数的划分"],
            ["常量", "常量本身，无副作用"],
            ["全局变量", "始终可见，不经捕获通道"],
            [3000, 6020]],
        ["p", "可写借用参数不在白名单内，这是本章最需要记住的一条。原因不是书写风格，而是语义：可写借用\
               不是副本，而是指向调用方对象的引用。若闭包捕获了它并逃逸出去，引用所指的对象可能已经不存\
               在。"],
        ["code", "tie", "
// 错误：闭包捕获可写借用参数
func make(ref t: table<i64>) -> fn() -> i64 {
    return func() -> i64 { return len(t) }
}
"],
        ["p", "在不安全上下文中，这条限制放宽——那里由书写者承担引用有效性的责任（见第 11 章）。"],
        ["h3", "捕获的语义"],
        ["p", "捕获分两类。标量、结构与枚举按值捕获：捕获发生在闭包创建的时刻，此后外围变量再改变，闭包\
               看到的仍是创建时的值。表与映射按引用捕获：闭包与外围看到同一份底层数据，闭包内对内容的修\
               改外围可见，反之亦然。语言不为容器做隐式复制——复制容器是显式操作，它的成本必须由书写者看\
               见而不是被语言悄悄支付。"],
        ["note", "表按引用捕获意味着闭包可能形成共享可变状态：这是本规则唯一的例外通道。把携带容器的闭包交\
                  给其他执行流之前，必须确信不存在并发写入，或把访问收敛到单一执行流（见第 10 \
                  章）。需要彻底隔离时，显式复制一份再捕获。"],
        ["h2", "5.11  外部函数"],
        ["p", "extern 声明外部实现的函数，用于调用操作系统或第三方库。声明给出名称与签名，不含函数体。"],
        ["code", "tie", "
extern func getenv(name: string) -> i64
"],
        ["p", "外部函数可能返回指针或写入调用方的缓冲区，因此调用点通常需要不安全上下文。对系统调用与 \
               C 库的封装应当集中在少数模块内，其余代码使用封装后的安全接口。"],
        ["h2", "5.12  等号体与表达式体"],
        ["p", "函数体有两种简洁形态：体是单个表达式时，可以省略花括号直接写在等号之后；或者写在花括号内\
               而不写返回语句。二者语义相同——都等价于把该表达式的值返回。"],
        ["code", "tie", "
func twice(x: i64) -> i64 = x * 2
func square(x: i64) -> i64 { x * x }
func log(x: i64) -> void = println(to_string(x))   // 无返回值：值被丢弃
"],
        ["p", "返回类型必须显式标注，不因体简化而省略——返回值是函数契约的一部分，不应当需要读者去推导。\
               需要多条语句、或需要提前返回时，仍使用完整的块体。"],
        ["h2", "5.13  隐式单参闭包"],
        ["p", "短闭包还有一种更短的形态：单参数的闭包可以省略参数名，直接使用约定的名字指代该参数。适用\
               的场合是上下文已经给出函数类型、而参数名对可读性无所增益时。"],
        ["code", "tie", "
var doubled = map(xs, { it * 2 })
var names = map(users, { it.name })
"],
        ["p", "参数类型与返回类型由上下文的函数类型推定。上下文不明确时报错，而不是猜测一个类型——这是语\
               言在「简洁」与「可诊断」之间的固定取舍。"],
        ["h2", "5.14  实参展开"],
        ["p", "调用时可以把一个表的元素铺开成多个实参，用于把已有数据转交给变长形参。展开记号在元素前后\
               均可使用，多个展开可以并列。"],
        ["code", "tie", "
var xs: table<i64> = [1, 2, 3]
var t = sum(xs...)            // 全部铺开
var u = cat(5, 6, xs..., 100)  // 与固定实参混用，展开在中间
var v = sum_all(a..., b...)    // 多个展开依序平铺
"],

        // ===== 第 6 章  数据结构 =====
        ["h1", "第 6 章  数据结构"],
        ["p", "tie 在结构设计上采取一条明确的分离原则：结构只描述数据，逻辑写在命名空间函数里，二者通过\
               名称绑定。这条原则使「这是一个什么东西」与「可以对它做什么」成为两件独立的事，各自可以单\
               独演进。"],
        ["h2", "6.1  结构的定义"],
        ["p", "结构由字段组成，字段有类型与可选的默认值。结构是纯数据——不包含方法、不包含虚表、不引入隐\
               式状态。"],
        ["code", "tie", "
struct Point {
    var x: f64 = 0.0
    var y: f64 = 0.0
    var label: string = \"\"
}
"],
        ["p", "字段的默认值使得构造可以只给出关心的部分，其余取默认。"],
        ["h2", "6.2  构造与字段访问"],
        ["p", "构造按字段顺序给出实参。字段访问用点号。"],
        ["code", "tie", "
var p = Point(1.0, 2.0)
p.x = 3.0
println(p.label)
"],
        ["p", "结构作为参数时默认按值传递；对较大的结构使用只读借用以避免复制，需要修改时使用可写借用。"],
        ["h2", "6.3  逻辑与数据分离"],
        ["p", "结构的行为写在同名命名空间内。命名空间函数的第一个参数是接收者。"],
        ["code", "tie", "
namespace Point {
    pub func dist(p: Point) -> f64 {
        return sqrt(p.x * p.x + p.y * p.y)
    }

    pub func move_by(ref p: Point, dx: f64, dy: f64) {
        p.x += dx
        p.y += dy
    }
}
"],
        ["p", "这一组织方式有一个直接好处：结构定义保持稳定，而逻辑可以增补、分组、按需导入。新增一个操\
               作不需要改动结构所在的文件。"],
        ["h2", "6.4  方法调用"],
        ["p", "点号调用是对命名空间函数的转发：编译器把 obj.method(args) 解释为「与 obj \
               从属的命名空间下的 method，接收者作为第一个参数」。前提是 「obj \
               有成员可谈从属」——结构（字段与同名命名空间的方法）、枚举（变体与方法）、命名空间与文件（\
               成员）。「纯数据值不设点」：表与字符串没有成员，它们的操作写成自由函数 `op(xs, …)`（如 \
               `table_pop(t)`），或送进箭头 `xs -> op(…)`（数据作末参）。"],
        ["code", "tie", "
var p = Point(3.0, 4.0)
println(p.dist() -> to_string)

p.move_by(1.0, 1.0)

table_pop(t)         // 表操作：自由函数
t -> table_pop()     // 表操作：箭头（数据作末参）
"],
        ["p", "转发意味着方法的参数规则与普通函数完全一致——默认参数、命名实参、借用与转移约定都可以用在\
               方法上。接收者不参与命名，也不能被默认值补齐：它由调用对象给出。"],
        ["code", "tie", "
struct Counter { var n: i64 = 0; }

namespace Counter {
    pub func bump(c: Counter, step: i64 = 1) -> i64 {
        return c.n + step
    }
}

c.bump()             // step 取默认
c.bump(step: 4)      // 命名实参
"],
        ["p", "接收者的传递约定由命名空间函数声明决定：需要修改调用对象时把接收者声明为可写借用。"],
        ["p", "自由函数形态与方法形态语义完全相同，可以互相改写。正文示例以方法形态为主——它让「谁在做什\
               么」读起来最直白；自由函数保留两个用途：机器生成代码的稳定形态，以及管道中把函数本身作为\
               值传递的场合。"],
        ["h2", "6.5  继承"],
        ["p", "结构可以继承另一个结构的字段，形成「更具体的类型」。继承只复用字段，不引入方法表——行为仍\
               然由命名空间函数提供。"],
        ["code", "tie", "
struct Shape {
    var name: string = \"\"
}

struct Circle extends Shape {
    var r: f64 = 0.0
}
"],
        ["p", "子类型可以传给期望父类型的参数，字段按前缀布局，因此转换不需要额外工作。"],
        ["h2", "6.6  语义限制"],
        ["p", "以下限制在编译期检查，它们共同保证结构是纯数据的这一性质。"],
        ["ul", [
            "结构体内不得定义函数；行为写在同名命名空间内",
            "字段名在同一结构内唯一",
            "继承链不得成环",
            "字段默认值必须是常量表达式",
            "结构作为参数时不得隐式发生窄化转换",
        ]],
        ["note", "这些限制不是风格偏好，而是设计后果：结构不携带行为，就没有虚表、没有构造顺序问题、没有隐\
                  式析构。调试时看到一个结构值，就看到了它的全部状态。"],
        ["h2", "6.7  与元组的关系"],
        ["p", "元组适合表达「几个值临时组合」；结构适合表达有名字、会长期存在、有自己行为的概念。判据是\
               命名与复用：需要按名字取用、需要在多处传递，就用结构。"],
        ["code", "tie", "
// 临时组合：用元组
var (lo, hi) = min_max(xs)

// 长期概念：用结构
struct Interval {
    var lo: i64 = 0;
    var hi: i64 = 0;
}
"],
        ["h2", "6.8  运算约定"],
        ["p", "结构可以定义运算符的含义。做法是在同名命名空间里提供约定名称的函数，编译器在遇到相应运算\
               时调用它。这样自定义类型可以像内建类型一样书写，而不必到处写方法调用。"],
        ["tblw",
            ["约定名", "触发的运算"],
            ["add / sub / mul / div", "相应的二元算术"],
            ["neg", "一元取负"],
            ["eq / cmp", "相等比较与大小比较"],
            ["index / index_set", "下标读取与下标赋值"],
            ["to_string", "转为文本"],
            [3400, 5620]],
        ["code", "tie", "
namespace Vec2 {
    pub func add(a: Vec2, b: Vec2) -> Vec2 {
        return Vec2(a.x + b.x, a.y + b.y)
    }
    pub func eq(a: Vec2, b: Vec2) -> bool {
        return a.x == b.x && a.y == b.y
    }
}

var v = p + q          // 调用 Vec2::add
if p == q { }          // 调用 Vec2::eq
"],
        ["p", "约定名称是一份固定清单，不接受任意名称。约定函数是普通函数，可以单独调用——运算符只是它的\
               另一种写法，不存在只能通过运算符访问的行为。"],
        ["h2", "6.9  计算属性"],
        ["p", "对需要按需计算、不宜存储的值，可以定义一对同名函数作为读写入口：读函数除接收者外无参数，\
               写函数多一个值参数。访问时用普通的字段语法。"],
        ["code", "tie", "
namespace Circle {
    pub func area(c: Circle) -> f64 { return 3.14159 * c.r * c.r }
    pub func label(c: Circle) -> string { return \"圆 \" + to_string(c.r) }
    pub func label_set(ref c: Circle, v: string) { c.name = v }
}

var a = c.area        // 读：调用计算
"],
        ["p", "读入口与普通字段访问在调用点写法一致，因此这个值究竟是存下来的还是算出来的属于实现细节，\
               改动它不影响使用方。写入口需要接收者可写借用，因为写入必然修改对象。"],
        ["h2", "6.10  遍历约定"],
        ["p", "要让自定义类型可用于遍历语句，在命名空间里提供两个约定函数：一个判断是否还有元素，一个取\
               出当前元素并前进。有了它们，该类型就能出现在遍历语句中。"],
        ["code", "tie", "
namespace Ring {
    pub func has_next(r: Ring) -> bool { return r.i < r.n }
    pub func next(ref r: Ring) -> i64 { r.i += 1; return r.buf[r.i - 1] }
}

for v in ring { println(to_string(v)) }
"],
        ["p", "约定遍历的行为与内建表一致：遍历中的修改规则、元素顺序、取尽后的判定都遵循同一套语义，因\
               此使用方不必区分遍历的是表还是自定义类型。"],
        ["p", "此外，形如 `fn() -> Option<T>` 的值（流，见 6.11）同样可以直接遍历——每次调用取下一个元素\
               ，取尽以 None 表明。"],
        ["h2", "6.11  迭代器适配"],
        ["p", "遍历约定之上还有一层适配函数，用于把「逐个取元素」组合成常用的变换。适配函数是自由函数，\
               作用于一切满足遍历约定的类型——内建表与自定义类型同等对待。"],
        ["tblw",
            ["函数", "语义"],
            ["iter_map(f, xs)", "逐元素变换，产出 f(元素)；返回新表。"],
            ["iter_filter(p, xs)", "保留判定为真的元素；返回新表。"],
            ["iter_take(n, xs)", "取前 n 个元素；返回新表。"],
            ["iter_zip(a, b)", "两路并读，产出 (a_i, b_i) 元组，短者取尽即止。"],
            ["iter_chain(a, b)", "先后串接两路元素。"],
            [4600, 4420]],
        ["code", "tie", "
var top = scores -> iter_map(func(v: i64) -> i64 { return v * 2 }) -> iter_filter(func(v: i64) -> bool { return v > 0 })
for (name, score) in iter_zip(names, scores) {
    println(name + \": \" + to_string(score))
}
"],
        ["h3", "惰性流"],
        ["p", "上表的适配函数逐元素物化，适合表内数据。需要在大序列上短路求值时（例如「取前十个」而源还\
               有余量），用「流」：流是一个每次调用返回下一个元素的函数——有素即 \
               `Option.Some(元素)`，取尽恒 `Option.None`。表经 `stream_from` \
               成流；适配链逐元素传递，`stream_take` 达到数量后不再向上游拉取；遍历语句直接消费流（有素\
               绑定元素执行循环体、取尽退出）。适配函数：`stream_map`、`stream_filter`、`stream_take`（\
               保持流形态）；`stream_collect`（成表）、`stream_each`（逐元素应用）收束。"],
        ["code", "tie", "
var top2 = scores -> stream_from() -> stream_take(10) -> stream_collect()
for v in stream_from(scores) -> stream_take(3) {
    println(to_string(v))
}
"],
        ["p", "适配器是惰性的：组合若干适配器不产生中间表，元素在被遍历到的那一刻才计算并流动。这条约定\
               让「变换链」的成本与手写循环相当，也使适配器可以安全作用于无限序列（如计数源）。需要把结\
               果固化为表时，用 table_from(xs) 收拢。"],

        // ===== 第 7 章  接口 =====
        ["h1", "第 7 章  接口"],
        ["p", "接口描述一组能力：满足这组签名要求的类型，就可以被当作这个接口使用。接口是泛型约束与多态\
               的基础，也是模块之间约定边界的主要手段。"],
        ["h2", "7.1  声明"],
        ["p", "接口用 port 声明，其中列出方法签名。签名只写参数与返回类型，不含实现。"],
        ["code", "tie", "
port Drawable {
    pub func draw(self, ctx: i64) -> string
    pub func bounds(self) -> i64
}
"],
        ["p", "self 是接收者占位，实现时由具体类型替换。"],
        ["h2", "7.2  实现"],
        ["p", "类型通过 impl 块声明它实现某个接口，并在其中给出各方法。接口要求的每个方法都必须实现，遗\
               漏在编译期报告。"],
        ["code", "tie", "
struct Button {
    var label: string = \"\"
    var w: i64 = 0
    var h: i64 = 0
}

impl Drawable for Button {
    pub func draw(self, ctx: i64) -> string {
        return \"Button(\" + self.label + \")\"
    }
    pub func bounds(self) -> i64 {
        return self.w * self.h
    }
}
"],
        ["p", "实现块中的 self 指向实现类型本身，因此实现体可以直接访问该类型的字段。"],
        ["h2", "7.3  作为约束"],
        ["p", "泛型参数可以标注接口约束。约束在编译期检查：传入的类型必须实现了该接口，否则报错。"],
        ["code", "tie", "
func render_all<T: Drawable>(items: table<T>, ctx: i64) {
    for it in items {
        it.draw(ctx)
    }
}
"],
        ["p", "带约束的泛型在编译期为每个具体类型生成一份实现。因此调用没有间接跳转，也能被内联——接口在\
               这里不带来运行期开销。"],
        ["h2", "7.4  作为对象"],
        ["p", "接口也可以作为运行期的对象类型使用：把不同具体类型的值放入同一个接口类型的变量或表中，调\
               用时按实际类型分派。"],
        ["code", "tie", "
var items: table<Drawable> = []
items <- button
items <- label
for it in items {
    it.draw(0)
}
"],
        ["p", "这一形态在需要异质集合时使用，例如界面中混合放置不同控件。开销与任何动态分派方案相同，因\
               此在不必要时优先使用泛型约束的形态。"],
        ["note", "两种形态共用同一份接口声明。选择哪一种取决于调用点是否需要异质集合：类型在编译期全部已知\
                  ，用约束；需要把不同类型放进同一个容器，用对象。"],
        ["h2", "7.5  接口的组合"],
        ["p", "接口可以要求另一个接口，从而在能力之上再叠能力。实现时必须同时满足全部要求。"],
        ["code", "tie", "
port Focusable {
    pub func focus(self) -> bool
}

port Control {
    pub func draw(self, ctx: i64) -> string
    pub func focus(self) -> bool
}
"],
        ["p", "组合让约束可以按能力分片：小接口易于实现也易于复用，大接口由小接口拼成，实现方仍只需提供\
               具体方法。"],
        ["h2", "7.6  两种接口"],
        ["p", "接口有两种形态，区别在于「要求是否必须被显式声明」。"],
        ["tblw",
            ["形态", "要求"],
            ["名义接口", "类型必须显式声明它实现了该接口。声明与实现分开书写，实现块中逐方法给出定义。"],
            ["结构接口", "只要类型具备接口要求的方法，即视为满足。无需显式声明。"],
            [3400, 5620]],
        ["code", "tie", "
// 名义接口：必须 impl
port Drawable { pub func draw(self, ctx: i64) -> string }
impl Drawable for Button { pub func draw(self, ctx: i64) -> string { return \"B\" } }

// 结构接口：具备方法即可
interface Named { pub func name(self) -> string }
// 任何有 name(self) -> string 的类型都满足 Named
"],
        ["p", "选择依据是意图。名义接口用于表达「这是一份契约，实现方必须知情」；结构接口用于表达「这个\
               算法只要求这些能力」，此时关心的是能力而非声明。二者的约束检查都在编译期完成，也都能作为\
               泛型约束使用。"],

        // ===== 第 8 章  错误处理 =====
        ["h1", "第 8 章  错误处理"],
        ["p", "tie 把「可预期的失败」与「不可恢复的故障」分开处理。前者是返回值的一部分，调用方必须面对\
               ；后者终止执行并给出位置信息。这样区分的原因是二者的处理方式根本不同：前者需要分支决策，\
               后者需要诊断信息。"],
        ["h2", "8.1  可预期的失败"],
        ["p", "可能失败的函数把失败编码进返回类型。语言提供两个通用型别用于此目的：一个表示「有值或无值\
               」，一个表示「成功值或错误值」。"],
        ["code", "tie", "
func find(xs: table<i64>, target: i64) -> Option<i64> {
    for x in xs {
        if x == target { return Some(x) }
    }
    return None
}

func parse_port(s: string) -> Result<i64, string> {
    if s.len() == 0 { return Err(\"空输入\") }
    return Ok(to_i64(s))
}
"],
        ["h2", "8.2  传播"],
        ["p", "当函数无法就地处理失败、需要把它交给调用方时，用问号后缀传播：成功则取出值继续，失败则立\
               即返回。"],
        ["code", "tie", "
func config_port(cfg: map<i64>) -> Result<i64, string> {
    var raw = cfg[\"port\"]?
    var port_no = parse_port(raw)?
    return Ok(port_no)
}
"],
        ["p", "传播记号把「错误向上传递」这条最常见路径写成一个字符，从而让函数体里的正常路径保持直线——\
               不必为每一层调用写一段相同的分支。"],
        ["h2", "8.3  分支处理"],
        ["p", "需要针对具体情况分别处理时，用多分支匹配展开结果类型。编译器要求覆盖全部情形。"],
        ["code", "tie", "
switch parse_port(input) {
    case Ok(v):
        println(\"端口 \" + to_string(v))
    case Err(msg):
        println(\"失败：\" + msg)
}
"],
        ["p", "对于「缺失则取默认」这一常见需求，用安全默认值记号直接表达，不必展开分支。"],
        ["code", "tie", "
var port_no = cfg[\"port\"] ?: 8080
"],
        ["h2", "8.4  标准组合子"],
        ["p", "标准库提供一组转换与组合函数，用于在结果类型之间衔接，减少手写分支。"],
        ["code", "tie", "
var doubled = parse_port(s) -> map_result(v -> v * 2)
var len_ok = parse_port(s) -> and_then(validate_range)
"],
        ["h2", "8.5  不可恢复的故障"],
        ["p", "当故障意味着「程序状态已经不可信」时，用 panic 终止。它携带一条消息，用于定位问题。"],
        ["code", "tie", "
if len(buf) == 0 {
    panic(\"缓冲区不应为空\")
}
"],
        ["p", "在明确划定边界的场合可以捕获 panic 并转为普通错误，例如服务的请求处理循环：单个请求的故\
               障不应终止整个进程。捕获点应当少而集中，且必须能说明为什么在此处恢复是安全的。"],
        ["h3", "内建检查"],
        ["p", "表与数组的下标越界（含负下标）、除零，以及带检查运算的溢出，都会触发内建检查。检查报告源\
               码位置与相关的量——下标越界给出下标与长度，除零给出发生处，使故障不必靠复现去猜。"],
        ["p", "这些检查与 panic 走同一条失败路径：在捕获域内被接住并转为普通错误，域外终止进程。它们不\
               可关闭，因为其成本相对故障后果可以忽略。"],
        ["h2", "8.6  错误信息"],
        ["p", "错误值应当说明发生了什么、在哪一步发生。把上下文带在错误里，比在每一层重新描述问题更有用\
               。"],
        ["code", "tie", "
return Err(\"读取配置失败：字段 \" + name + \" 缺失\")
"],
        ["note", "错误类型的选取遵循一条经验：能枚举的用枚举，不能枚举的用文本。当调用方需要按类别分支时用\
                  枚举；当调用方只是向上传递或打印时用文本。"],
        ["h2", "8.7  错误链"],
        ["p", "错误在层层传播中会远离它的根因。语言为此提供包装机制：错误值可以携带一个下层错误，形成一\
               条链。链的最外层说明「这一步做什么失败了」，逐层向下是「为什么失败」，链底是根因。"],
        ["tblw",
            ["函数", "语义"],
            ["r.wrap_err(msg)", "作用于 Result：Ok 原样通过，Err 以新消息包装并挂入下层错误。"],
            ["e.cause()", "取下层错误；无下层时返回 None。"],
            ["e.root_cause()", "沿链取到最底层根因。"],
            [3800, 5220]],
        ["code", "tie", "
func load_config() -> Result<Conf, string> {
    var raw = read_file(path) -> wrap_err(\"读取配置失败\")?
    return parse_conf(raw) -> wrap_err(\"配置解析失败\")?
}

switch load_config() {
    case Err(e):
        println(e)                  // 给用户看：最外层消息
        println(e.root_cause())      // 给排障看：最初根因
}
"],
        ["note", "包装的纪律是逐层补充语境、不重复内容：每一层只说这一步发生了什么，不抄写下层已有的消息。\
                  展示给用户的取最外层，日志与排障的取根因，中间层只在逐层排查时才展开。"],

        // ===== 第 9 章  模块与导入 =====
        ["h1", "第 9 章  模块与导入"],
        ["p", "程序由多个文件组成，文件之间通过导入建立依赖。本章说明导入的语法、可见性规则与命名空间的\
               角色。"],
        ["h2", "9.1  导入"],
        ["p", "导入把另一个文件的内容引入当前文件，并可选地给它一个别名。别名用于限定访问，使来源在调用\
               点清晰可见。"],
        ["code", "tie", "
import \"./geometry.tie\" as geo
import \"./format.tie\"

var d = geo.distance(a, b)
"],
        ["p", "不写别名时，被导入文件的公开名称直接进入当前作用域，适合导入内容很少的文件。来源较多时使\
               用别名，避免名称冲突。路径有两种写法：相对当前文件以 ./ \
               起头（./geometry.tie），标准库模块以库根起头（/std/string.tie）；两者都写到文件名并带扩\
               展名。"],
        ["h3", "导入时机"],
        ["p", "导入默认采用半惰性：被导入模块的声明在进入作用域时可见，其初始化按首次使用的需要展开。\
               声明前可以加时机前缀：lazy 明确要求推迟展开，eager 明确要求入口即完整展开。两者都是可\
               选修饰，裸 import 保持默认。"],
        ["code", "tie", "
import \"./geometry.tie\"
lazy import \"./heavy.tie\"
eager import \"./bootstrap.tie\"
"],
        ["p", "按名查找、反射与外部接口是裁剪的边界：这类用途无法由静态引用分析覆盖，须在声明上显式\
               标注保留，否则可达裁剪可能移除它们所依赖的声明。"],
        ["h2", "9.2  命名空间"],
        ["p", "命名空间把一组函数组织在同一个名称之下。命名空间可以跨越多个文件：若干文件声明同一个命名\
               空间时，它们的内容合并为一份。"],
        ["code", "tie", "
namespace math {
    pub func gcd(a: i64, b: i64) -> i64 {
        if b == 0 { return a }
        return gcd(b, a % b)
    }
}
"],
        ["p", "命名空间可以嵌套，形成层次化的名称。嵌套的层级同时表达归属关系：内层命名空间只在外层可见\
               的范围内被引用。"],
        ["note", "跨文件的分片需要由主文件显式导入分片，命名空间才会合并。只在别处导入分片而主文件未导入它\
                  ，会得到「名称未定义」——这是导入关系的正常结果，不是缺陷。"],
        ["h2", "9.3  可见性"],
        ["p", "声明默认是私有的，只有标注 pub 才对外可见。可见性在导入边界上检查：被导入文件的私有名称\
               不出现在导入方的作用域中。"],
        ["code", "tie", "
func helper() { }        // 仅本文件可见
pub func api() { }       // 对外可见
"],
        ["p", "私有是本语言在处理跨文件访问时的默认选择。理由很实际：默认私有使得一个文件内部的调整不会\
               意外影响其他文件，公开面需要显式付出决策成本。"],
        ["h2", "9.4  标准库"],
        ["p", "标准库以模块为单位提供。常用模块与其职责如下。"],
        ["tblw",
            ["模块", "职责"],
            ["string", "文本查找、切分、替换、大小写"],
            ["utf", "码点与字节的转换、字符分类"],
            ["collection", "表与映射的常用操作"],
            ["sort", "排序与查找"],
            ["math", "数值函数与统计"],
            ["regex", "正则匹配与替换"],
            ["fs", "文件与目录"],
            ["path", "路径拼接与分解"],
            ["json", "数据交换格式的读写"],
            ["time", "时间与日期"],
            ["random", "随机数"],
            ["process", "进程与环境"],
            ["net", "网络通信"],
            ["crypto", "散列与加密"],
            [3000, 6020]],
        ["h3", "默认可见的内建"],
        ["p", "有一批内建不经过导入即可使用：全部内建函数族（len、to_string、str_ 系、sort 系、iter_ \
               系等，见各章定义），以及结果类型的四个构造名。构造名以裸名提供，书写错误分支时不必每次写\
               全限定名。"],
        ["code", "tie", "
func parse(s: string) -> Result<i64, string> {
    if s.len() == 0 { return Err(\"空输入\") }
    return Ok(to_i64(s))
}

func first(xs: table<i64>) -> Option<i64> {
    if len(xs) == 0 { return None }
    return Some(xs[0])
}
"],
        ["p", "Ok、Err、Some、None 是裸名而非关键字：它们默认可见，也可以被同名声明遮蔽。带限定的全名 \
               Result.Ok 与裸名等价，跨模块书写或需要消除歧义时用全名。"],
        ["h3", "内置库的准入"],
        ["p", "进入内置库的能力必须是通用的：一般程序用得到，且不依赖编译器运行时的场景假设。实现更快\
               但只在编译器场景成立、换到一般程序就不安全的能力，留在编译器内建，不进入内置库。"],
        ["p", "通用算法以库的源代码承载，可审计、可独立验证、可随语言演进；编译器只保留必须依赖语法\
               树与类型信息的分派与折叠。外部函数直通一类的能力下沉到库后，用户侧调用形态不变。"],
        ["p", "库可以在自身文件内使用不安全域封装底层操作。能力域凭据不随导入传播，因此使用库的一方\
               无需持有该凭据，危险面集中在库文件内部。"],
        ["h2", "9.5  依赖与版本"],
        ["p", "包管理器按版本解析依赖，并把解析结果与校验信息记录在项目文件中。依赖的引入应当在项目级完\
               成，而不是在源文件中按路径直接引用。"],
        ["code", "tie", "
// 项目文件（tie.pkg）中记录依赖与版本约束
name: my-project
require:
    json    ^2.1
    net     ~1.4
"],
        ["p", "版本约束使用语义化的范围记号，使得依赖升级的边界在文件里可见。"],
        ["h2", "9.6  选择性导入与重导出"],
        ["p", "导入可以只引入需要的名字，也可以给整个文件起别名，还可以把导入的名字再导出给使用本文件的\
               人。"],
        ["code", "tie", "
import \"/std/string.tie\"                 // 整个模块，用模块名限定访问
import \"/std/string.tie\" as str          // 起别名
import \"/std/string.tie\".{ join, repeat } // 只引入列出的名字
pub import \"/std/json.tie\"                // 重导出：使用本文件者也能看到它
"],
        ["p", "选择性导入用于收窄依赖面：文件开头一行即可看出这份代码实际用到了外部模块的哪些能力。重导\
               出用于把若干模块聚合成一个对外入口，使用方只需导入一处。"],
        ["h2", "9.7  引入命名空间"],
        ["p", "using 把某个命名空间的名字直接引入当前作用域，此后引用其中的名字不必再加前缀。"],
        ["code", "tie", "
using args
using time
"],
        ["p", "它适用于使用频繁、且不会与其他名字冲突的命名空间。作为对照，导入别名不改变名字的可见性——\
               别名只是缩短前缀，读者仍能从调用点看出名字来自哪个模块。是否使用 using \
               是一个可读性判断：让来源显而易见，比少写几个字符更重要。"],
        ["h2", "9.8  数据格式"],
        ["p", "语言自带一种数据表达格式，用于配置文件、接口描述与数据交换。它的语法就是 tie \
               的表与字面量语法——不需要学习第二套写法，也不需要为数据单独维护一套解析器。"],
        ["p", "格式有两种载体：可读的文本形式与等价的二进制形式。二者表达同一份数据，前者便于阅读与版本\
               对比，后者便于机器读写与传输。同一份定义可以在两种形式间转换，语义不变。"],
        ["code", "tie", "
// 可读形式：与 tie 的表字面量同形
api = [
    [ \"id\": \"tsci.linalg\", \"version\": \"0.1.0\" ],
    [ \"funcs\": [
        [ \"name\": \"mat_mul\", \"in\": 2, \"out\": 1 ],
    ],
    ],
]

// 读取：得到一个普通映射，之后按映射规则访问
var id = api[0][\"id\"]
"],
        ["p", "这种格式的定位是生态内的通用数据面：接口定义、构建配置、测试语料都用它表达，因而工具链只\
               需理解一种格式。明文与二进制两种载体的完整规范——td 语法、zd 序列化、tink 帧协议与 tsha1 \
               哈希家族——见第 17 章。"],
        ["h2", "9.9  依赖声明"],
        ["p", "项目依赖写在项目文件里，含名称与版本约束。版本约束用语义化的范围记号表达，升级边界因此在\
               文件里可见。源文件本身按模块名导入，不携带版本信息——版本解析是项目级的事，不该散落在各处\
               。"],
        ["code", "tie", "
// 项目文件（示意）
name: my-project
require:
    json    ^2.1
    net     ~1.4
    crypto  >=3.0
"],

        // ===== 第 10 章  并发 =====
        ["h1", "第 10 章  并发"],
        ["p", "并发在 tie 里由两类构造承担：actor 提供隔离的状态单元，任务图提供带依赖的并行调度。两者\
               的共同前提是「默认不共享可变状态」——共享是通过显式通道或消息传递发生的，不是通过共享内存\
               偶然发生的。"],
        ["h2", "10.1  并发的基本立场"],
        ["p", "数据竞争通常来自两处：两个执行流访问同一块可写内存；或者一处持有指向另一处栈帧的引用。语\
               言在设计上分别封堵："],
        ["ul", [
            "共享可变状态通过消息传递表达，通道有明确的所有权归属",
            "可写借用不能被闭包捕获，因此不会随函数值逃逸到别的执行流",
            "跨线程传递的值按值复制，不建立隐式别名",
        ]],
        ["h2", "10.2  状态单元"],
        ["p", "actor 是并发的基本单位：它拥有自己的状态，只通过消息与外界交互。对它的状态的访问全部发生\
               在它自己的执行流里，因此不需要锁。"],
        ["code", "tie", "
actor Counter {
    var n: i64 = 0

    func inc(step: i64) {
        n += step
    }

    func value() -> i64 {
        return n
    }
}

var c = Counter()
c.inc(5)
println(to_string(c.value()))
"],
        ["p", "调用 actor 方法即发送消息。消息在队列中排队，按到达顺序处理，因此状态变化的顺序是可预期\
               的。"],
        ["h2", "10.3  消息与返回"],
        ["p", "消息可以携带数据。需要结果时，调用等待回复并把结果作为表达式的值。带返回值的调用与普通调\
               用写法相同，等待是隐式的。"],
        ["code", "tie", "
var total = c.value()
"],
        ["p", "发送方与接收方之间传递的数据按值语义复制或转移，因此不存在双方同时持有同一块可写内存的情\
               形。"],
        ["h2", "10.4  任务与依赖"],
        ["p", "当工作之间存在依赖关系时，用任务图描述：节点是工作单元，边是依赖。调度器按依赖顺序推进，\
               互不依赖的节点并行执行。"],
        ["code", "tie", "
var g = graph()
var a = g.add(fetch_a)
var b = g.add(fetch_b)
var c = g.add(merge, a, b)      // c 依赖 a 与 b
g.run()
"],
        ["p", "任务图中传递的值遵循与 actor 相同的规则：跨节点传递即复制或转移。这使并行部分与串行部分\
               可以自由混合，而不必为边界处的数据归属单独设计。"],
        ["note", "并发构造的选择依据是「状态是否需要长期存在」。需要长期存在并被多方交互的状态放在 actor \
                  里；一次性的并行计算用任务图。"],
        ["h2", "10.5  与闭包捕获的关系"],
        ["p", "第 5 章的捕获面白名单在这里体现为一条直接的安全保证：由于可写借用不可被闭包捕获，任何函\
               数值都不持有对他人栈帧的可写引用。把函数值交给别的执行流时，不可能带入一个可写别名。"],
        ["p", "这条规则解释了为什么跨线程传递闭包大体是安全的：闭包携带的标量、结构与枚举都是创建时刻的\
               值快照，每个执行流拿到各自独立的副本。唯一的例外通道是容器捕获（见 \
               5.10）——表与映射按引用捕获，多个执行流因此共享同一份底层数据。把携带容器的闭包交给其他执\
               行流时，并发写入由书写者负责排除；需要共享状态时，把状态收敛到状态单元（见 \
               10.2），让访问经由消息串行化，而不是让多个执行流直接触碰同一个表。"],
        ["h2", "10.6  建立与调用"],
        ["p", "建立一个执行体用 run。它取其构造，返回一个句柄；句柄可以复制，多个副本指向同一个执行体，\
               就像同一个地址的多个引用。"],
        ["code", "tie", "
actor Counter {
    var n: i64 = 0

    pub func inc(step: i64) -> i64 {
        n += step
        return n
    }

    pub async func reset() {
        n = 0
    }
}

var c = run Counter()      // 建立，取得句柄
var v = c.inc(5)           // 同步调用：等结果
c.reset()                  // 异步投递：不等
"],
        ["p", "方法默认是同步的：调用方等待被调方处理完并取回结果。标注为异步的方法则是投递即返回——调用\
               方不等，被调方按到达顺序处理。何时需要等结果、何时只需告知，由方法签名直接表达，不由调用\
               点决定。"],
        ["h3", "结果的延后取得"],
        ["p", "异步方法也可以带回结果，此时调用得到一个代表将来会有值的凭据，需要取值时再等待。等待点上\
               若被调方出错，错误在等待处抛出——错误与结果走同一条路径，不必单独设计上报通道。"],
        ["code", "tie", "
var f = worker.compute(input)   // 异步：立即返回凭据
// ... 其间可做别的事
var r = await f                  // 需要时取值，可能在此抛出被调方的错误
"],
        ["p", "不需要结果时直接丢弃该凭据即可，行为等同于投递。这使得要不要结果不影响书写形态，只影响是\
               否等待。"],
        ["h2", "10.7  重入"],
        ["p", "执行体默认按消息逐条处理，一条处理完才取下一条。当某条处理需要等待另一个执行体的回信时，\
               这段等待会挡住队列。若这种相互等待成环，双方就会互锁。"],
        ["p", "把这类方法标注为重入，表示它在等待期间允许队列继续处理其他消息，从而打破环路。代价是等待\
               期间自身状态可能被改变，因此标注重入需要确认方法内部对状态变化的假设仍成立。"],
        ["code", "tie", "
actor Router {
    pub reentrant func route(id: i64) -> i64 {
        return downstream.lookup(id)   // 等待期间可继续处理其他消息
    }
}
"],
        ["h2", "10.8  字段初值"],
        ["p", "执行体的状态字段在声明处给出初值，且初值必须是字面量——数字、布尔、字符、字符串或空表。语\
               言不提供构造方法。"],
        ["code", "tie", "
actor Cache {
    var hits: i64 = 0
    var name: string = \"\"
    var items: table<i64> = []
}
"],
        ["p", "限制初值为字面量，是为了让状态在建立那一刻就是确定的：外部读不到半构造状态，也不需要为构\
               造顺序设计规则。需要更复杂初始化的情形，用一个显式的初始化消息完成，那次调用与普通消息走\
               同一路径。"],
        ["h2", "10.9  数据流图"],
        ["p", "需要表达若干工作单元与其依赖关系时，用图。图值与它描述的拓扑同构：花括号界定节点，箭头表\
               示前后依赖，并列表示并行分叉，波浪号前缀表示回边。"],
        ["code", "tie", "
// 图字面量：并行两路，之后汇合，并带一条回边
var flow = { A } - { B } -> { C -> ~ A }

// 表形态：节点与边逐条登记
var g = graph()
var a = g.add(fetch)
var b = g.add(parse, a)
var c = g.add(store, b)
var d = g.add(report, b)
g.run()                     // 按依赖顺序推进；无依赖者并行
"],
        ["p", "图本身是值：可以组合、可以传递、可以作为函数值求值。组合产生新图而不修改原图，因此一张图\
               可以在多处安全复用。把值送入图即触发执行，与管道写法一致。"],
        ["h3", "检查与查询"],
        ["p", "图提供一组查询操作，用于在构造后检查结构：节点与边的枚举、连通性、可达性、环路检测、拓扑\
               序、最短路径、关键路径、最大流与最小割。三态标记可以随图传播，用于在图上表达「是、未知、\
               否」的判定。这些是图值的一等能力，不必自行实现。"],

        // ===== 第 11 章  不安全机制 =====
        ["h1", "第 11 章  不安全机制"],
        ["p", "语言的安全保证建立在「不出现未定义行为」之上。绝大多数代码不需要违反这条前提，因此默认落\
               在安全区内；少数需要直接操作内存、调用外部接口或放宽检查的场合，语言提供一处显式标记：不\
               安全区。"],
        ["h2", "11.1  安全区的边界"],
        ["p", "安全区内不允许出现以下构造——它们在编译期被拒绝，而不是在运行期碰运气。"],
        ["ul", [
            "对指针的解引用与写入",
            "原始缓冲的分配与释放",
            "内存块的批量拷贝与填充",
            "易失访存与内联汇编",
            "调用标记为不安全的函数",
            "闭包捕获可写借用参数",
            "非结构化跳转",
        ]],
        ["p", "注意两处不在其列。其一，「指针类型」本身不在其列：声明、比较、传递一个指针值不会引发未定\
               义行为。其二，「产出指针值」的操作也不在其列：取地址、指针偏移、指针与整数之间的转换都是\
               纯值运算，不触碰内存，结果即便无效也只在被解引用时才成为问题，而解引用另有门禁。安全与不\
               安全的这条线，画在「是否要求书写者先满足某个安全前提」上（见 11.8）。"],
        ["p", "这些限制覆盖了内存不安全的主要来源：悬垂引用、越界访问、类型混淆、数据竞争。"],
        ["h2", "11.2  不安全区"],
        ["p", "不安全区有两种形态：标记为不安全的函数，以及函数体内的不安全块。二者都把「此处由书写者承\
               担内存正确性的责任」写在代码里。"],
        ["code", "tie", "
unsafe {
    var buf = alloc(16)
    deref_write(buf, as_u8(1))
    var v = as_i64(deref(buf))
    free(buf)
}
"],
        ["p", "不安全函数在签名上标注 unsafe。安全代码调用不安全函数必须自己处在不安全区内，这一要求由\
               编译器强制：调用链上每一处跨越都必须显式。"],
        ["h2", "11.3  指针操作"],
        ["p", "指针类型在类型名上体现为 ptr 与元素类型。指针的「分配、读写与释放」在不安全区内进行；而\
               「产出指针值」的一应操作——取地址、偏移、与整数互转——不触碰内存，在安全代码中即可使用（见 \
               11.8）。指针值的声明、比较与传递同理。"],
        ["code", "tie", "
var p = alloc(64)              // 分配：须不安全区
var q = ptr_add(p, 8)          // 偏移到第 8 字节：安全（纯地址计算）
deref_write(q, as_i64(42))     // 写入：须不安全区
var n = as_i64(deref(q))       // 读出：须不安全区
var a = ptr_to_int(p)          // 转为整数：安全（纯转换）
free(p)                       // 释放：须不安全区
"],
        ["p", "指针与整数的双向转换使外部接口的调用可以表达：把地址作为整数传给不接受指针类型的接口，或\
               把返回的整数重新解释为指针。"],
        ["h2", "11.4  放宽的检查"],
        ["p", "不安全区内的部分检查放宽，由书写者承担后果。放宽的范围是明确的、有限的：指针操作相关的检\
               查与借用逃逸的检查。其余检查——类型相容、参数个数、分支完备性——在任何地方都不会关闭，因为\
               它们与内存布局无关。"],
        ["p", "闭包捕获可写借用的限制在不安全区内解除，用于需要把借用显式传递到回调的场合。此时借用的有\
               效期由书写者保证。"],
        ["h2", "11.5  审计友好"],
        ["p", "不安全机制的形态经过取舍：它不采用「关闭全文件检查」的开关，也不采用隐式的宽松规则，而是\
               要求把每个不安全操作写在标记区内。这样做的目的是让审计可以按文本搜索完成。"],
        ["ul", [
            "搜索 unsafe 即可定位全部需要人工复核的位置",
            "不安全区的边界在语法上可见，不依赖约定",
            "解引用记号使指针访问在语句层面可辨认",
        ]],
        ["note", "封装外部接口时，把不安全操作收敛到少数模块，对外只暴露签名安全、行为可预期的接口。这样不\
                  安全区的总量可控，复用这些封装的使用方无需关心内部细节。"],
        ["h2", "11.6  能力域与凭据"],
        ["p", "不安全操作按其触犯的安全前提分组，每组称为一个能力域。要执行某个域内的操作，必须持有该域\
               的凭据。凭据是一类特殊的值：它可以转移，但不能复制——因此同一时刻只有一处持有它，不存在权\
               限被悄悄扩散的情形。"],
        ["tblw",
            ["能力域", "覆盖的不安全操作"],
            ["mem", "解引用、指针算术、原始分配与释放、取地址。"],
            ["ext", "调用语言无法核对的外部代码——自行声明的外部函数、交给外部的函数指针、动态装载的库与按地址调用的函数。系统调用与常用库已由语言封装为安全接口，不需凭据。"],
            ["share", "跨执行流共享可变数据，越过「默认不共享可变状态」的前提。"],
            ["raw", "内联汇编、易失访存、非结构化跳转——直接绕过编译器对代码的假设。"],
            ["lock", "对容器的访问去掉运行时锁——越过「并发访问由运行时看护」的前提，正确性由书写者担责。"],
            [2200, 6620]],
        ["p", "要执行某个域内的操作，编译器检查两件事：所在位置处于不安全上下文（见 \
               11.2），且当前作用域持有该操作所属域的凭据。两件都满足才放行；缺凭据时诊断会指出该操作属\
               于哪个域、当前持有哪些域，并列出可用的持证写法。持错域的凭据不算数——持 mem 域凭据去做 \
               ext 域的操作同样被拒。"],
        ["p", "凭据不随作用域之外的边界传递：它不进入函数体内部（闭包体是独立函数，其内不继承外层的凭据\
               ），也不从引入方传给被引入的模块（每个文件按自己的头部声明持证）。"],
        ["p", "取得凭据的方式是显式请求。请求写成一次调用，返回凭据值；此后在一个显式的块内持证操作，块\
               结束时凭据失效。"],
        ["code", "tie", "
var g = unsafe.get(mem)            // 请求凭据
unsafe use g {                     // 持证块：块内可做该域的操作
    var p = alloc(64)
    \\\\p = as_u8(1)
}

unsafe with(share) {               // 作用域临时凭据：退块自动回收
    shared_counter += 1
}

unsafe with(lock) {                // 该块内对容器的访问不再取运行时锁
    buf[i] = v
}
"],
        ["p", "凭据可以派生：把域名再写一次，得到一份新的凭据，原凭据随之交出（此后不再可用）。也可以绑\
               定到特定对象，表示这份许可只对该对象有效。"],
        ["code", "tie", "
var sub = g.delegate(mem)          // 派生新凭据（同域）；原凭据交出
var bound = unsafe.get(mem -> buf)  // 绑定到具体对象
unsafe.revoke(g)                   // 撤销：此后凭据不可用
"],
        ["p", "撤销作用于凭据本身。撤销一份凭据后，由它（传递）派生出的凭据一并失效，再使用它们会被拒绝\
               ；撤销不因凭据已被派生交出而失去对象——一份凭据即便已经通过 delegate \
               交出去，仍可撤销它，从而收回其下游的全部许可。重复撤销同一凭据、或撤销根本不是凭据的值，\
               都会被拒绝。"],
        ["h3", "按模块授权"],
        ["p", "系统桥接与外部接口封装这类模块通篇都是不安全操作，逐个函数标注会淹没代码。此时在文件头部\
               一次性授权该文件可用的能力域，或在函数与执行体上标注，表示该单元整体持证。"],
        ["code", "tie", "
type tie<class, unsafe>            // 整个文件处于不安全上下文
type tie<class, unsafe:lock>       // 并授权 lock 域：本文件各函数隐式持该证
type tie<logic, unsafe:ext, unsafe:mem>   // 一次授权多个域（逗号分隔）
#[unsafe.share]                     // 函数级：该函数隐式持证（域写在标注里）
pub func aggregate() -> i64 { ... }
"],
        ["p", "持证共有四种写法，粒度由粗到细：文件头的角色声明（整个文件的各函数隐式持证）、函数上的标\
               注（该函数隐式持证）、unsafe use g 持证块（凭据作为值传入，退块回收）、unsafe with(域) \
               临时凭据块（声明域即持证，退块回收）。前两种适合整块代码同域的场合，后两种适合局部。"],
        ["p", "文件级授权只作用于这个文件：它被别的文件引入时，授权不会随之扩散过去；反过来，被引入的模\
               块也不继承引入方的授权，要什么域得自己声明。"],
        ["p", "按模块授权是粗粒度的，因此它的适用范围是「整块代码都属同一域」的场合。审计时这类文件仍然\
               可见——头部或标注本身就是标记，搜索能力域名称即可定位全部授权点。"],
        ["h2", "11.7  内联汇编"],
        ["p", "需要直接书写机器指令时用内联汇编。操作数以「方向加约束」的形式声明：哪些是输入、哪些是输\
               出、哪些既读又写，以及它们要占用寄存器还是内存。"],
        ["code", "tie", "
unsafe {
    asm!('add {dst}, {src}', dst: 输出(寄存器) = v, src: 输入(寄存器) = n)
}

// 操作数方向：输出 / 输入 / 既读又写
// 约束位置：寄存器 / 内存
"],
        ["p", "这份声明让编译器知道指令读了什么、写了什么，因而能在汇编块周围正确安排寄存器与内存的可见\
               性。把方向和约束写清楚，是内联汇编可被优化而不出错的前提。"],
        ["h2", "11.8  安全边界的重分类"],
        ["p", "安全与不平等的边界不是固定不变的，它随实现能提供的保证而移动。以下几类操作随着实现成熟，\
               从需要持证变为安全代码即可使用；下列重分类均已生效。"],
        ["ul", [
            "原子类型的全部操作（原子读写与比较交换）：此前需 mem 域，现由类型系统保证其正确使用。",
            "切片类型与其视图、长度与下标访问：此前需 mem \
            域，现由边界检查保证——越界是可捕获的失败，不是未定义行为。",
            "指针类型的声明、比较、传参与返回：此前需 mem 域，现只需不解引用即安全。",
            "产出指针值的一应操作——取地址、取字段地址、指针偏移、指针与整数互转：此前需 mem \
            域，现为纯值运算，不触碰内存。",
            "明确声明内存布局的结构：布局由声明保证，不需持证。",
        ]],
        ["p", "这组重分类的共同点是把边界从「类型」移到「操作」：说得出「一个指针」不等于能对它做危险的\
               事，所以类型本身不再需要持证，而危险操作照旧需要。"],
        ["p", "顺着这条线再推一步，边界可以收得更准：「一个操作需要持证，当且仅当它要求书写者先满足某个\
               安全前提」——这个前提可以是「指针有效」，也可以是「内存已初始化、未重复释放、长度不越界」\
               。产出指针值的一应操作没有这样的前提，因而全部归入安全区；而解引用、分配与释放、块拷贝、\
               易失访存各有前提，一律维持持证。"],
        ["p", "仍维持需要持证的是：对指针的解引用与写入、原始缓冲的分配与释放、内存块的批量拷贝与填充、\
               易失访存、内联汇编、非结构化跳转、调用语言无法核对的外部代码、跨执行流共享可变数据，以及\
               对容器访问去掉运行时锁。"],
        ["p", "这条边界线的划法是：凡实现能够自行保证其安全的，就归入安全区；凡安全性取决于书写者判断的\
               ，就维持持证。这条线只随实现能力移动，不随使用便利移动。"],

        // ===== 第 12 章  宏与元编程 =====
        ["h2", "11.9  空值与可空类型"],
        ["p", "任意类型都有对应的可空类型，记作 nullable T。可空值由标记与载荷组成：标记为零表示空值，\
               载荷在空值时不参与读取。标量类型的位空间已被合法取值占满，因此空值不编码进裸类型本身，\
               裸类型不因可空性改变其表示与应用二进制接口。"],
        ["code", "tie", "
type tie<logic, unsafe:null>

var x = unsafe null as i64
if is_null(x) { println(\"空值\") }
var y = x ?: 0
"],
        ["p", "空值创建必须带显式类型，并且处于 null 能力域。类型白名单限定于句柄类型与显式可空类型；\
               标量、聚合与枚举直接取空值由编译期拒绝。null 是独立于既有能力域的新域，凭据沿用不随\
               导入传播的规则。"],
        ["p", "判空是空值的唯一合法判定方式。长度读取、索引访问与容器遍历不隐式处理空值；把空值当作\
               普通值使用，在默认编译档由解引用检查给出明确诊断，发布档不插入该检查。"],
        ["p", "可空类型与裸类型不直接比较，须先经安全默认值记号或显式解包回到裸类型。空值与空值相等。\
               审计开关列出所有空值创建点与未在其支配域内判空即解引用的位置，只报告，不改变产物。"],
        ["h1", "第 12 章  宏与元编程"],
        ["p", "宏让代码可以生成代码。tie 的宏在编译期执行，输入与输出都是代码片段——代码在这里被当作普通\
               的值来传递，因此不需要为模板另造一套语言。"],
        ["h2", "12.1  代码片段"],
        ["p", "code 是编译期类型，它的值是一段语法结构，而不是运行期的数据。code \
               值只能出现在宏相关的上下文里，不能存进变量跨阶段使用。"],
        ["code", "tie", "
macro twice(x: code) -> code {
    return `(($x) + ($x))
}
"],
        ["h2", "12.2  宏的定义"],
        ["p", "宏用 macro 声明。宏在编译期被调用，其返回值替换调用点。由于展开发生在编译期，宏不带来运\
               行期开销。"],
        ["code", "tie", "
macro unless(cond: code, body: code) -> code {
    return `{ if !($cond) { $body } }
}

unless(done, cleanup())
"],
        ["h2", "12.3  引用与插值"],
        ["p", "引用记号把一段代码包成 code 值而不立即求值；插值记号把 code \
               值嵌入到引用中。二者配合，使宏作者可以描述「带空洞的代码模板」。"],
        ["code", "tie", "
`{ if $cond { $body } }      // $cond 与 $body 是空洞
`(($x) * 2)                 // 表达式形态：$x 位置由实参填入
"],
        ["p", "插值遵循与插值字符串 h\"...\" 一致的直觉：看到记号就知道此处会被替换，其余部分是字面结构。"],
        ["h2", "12.4  编译期计算"],
        ["p", "常量表达式在编译期求值。这使得查表、派生量、配置校验等可以在产物生成之前完成，运行期只留\
               下结果。"],
        ["code", "tie", "
const TABLE_SIZE = 1 << 10
const MASK = TABLE_SIZE - 1

macro assert_const(cond: code) -> code {
    // 在编译期检查条件，不满足则报错
    return `{ }
}
"],
        ["h2", "12.5  使用边界"],
        ["p", "宏适合表达那些「写法重复但语义简单」的结构：断言、日志、资源收尾、派生实现。它们不适合承\
               载主要业务逻辑，原因是宏展开后的代码在调试器里的位置信息不如直接书写的代码直观。"],
        ["ul", [
            "用宏消除重复的样板，不用宏制造新的语言",
            "宏的展开结果应当可以用手写代码等价表达",
            "宏的报错信息应当指向调用点，而不是展开内部",
        ]],
        ["note", "标准库的断言、日志与测试宏都遵循同一形态：调用点简洁，展开结果平凡，报错指向调用处。"],
        ["h2", "12.6  两种宏"],
        ["p", "宏有两种形态，区别在于宏作者面对的是「语法结构」还是「书写形式」。"],
        ["tblw",
            ["形态", "作者面对的"],
            ["函数式宏", "参数与返回值都是代码片段类型。宏体是一段普通代码，在编译期执行，对片段做任意加工。"],
            ["模板宏", "参数是书写形式本身。宏体给出展开模板，按形参与实参的对应关系替换。"],
            [3000, 6020]],
        ["p", "函数式宏适合需要逻辑判断的展开——按参数形态决定生成什么；模板宏适合形态固定的展开——把一段\
               样板中可变的几处抽出来。选择依据是作者手上需要的是结构还是形式。"],
        ["code", "tie", "
// 函数式：形参类型是代码片段，宏体在编译期执行
macro unless(cond: code, body: code) -> code {
    return `{ if !(@cond) { @body } }
}

// 模板：直接给出展开形态
macro twice(stmt) {
    @stmt
    @stmt
}
"],
        ["h3", "两种宏的写法对照"],
        ["p", "宏体里的代码片段需要与「原样保留的结构」区分开。准引用记号表示「这是一段代码结构，先不要\
               执行」；插值记号表示「此处嵌入一个片段」。二者配合，宏作者可以精确描述「哪些部分固定、哪\
               些部分由实参填入」。"],
        ["code", "tie", "
// 准引用：包住一段代码结构
var tpl = `{ if @cond { @body } }

// 插值：把片段嵌入准引用
`(($x) * 2)      // $x 位置由实参填入
"],
        ["p", "模板宏里以特定前缀命名的形参表示卫生临时名：展开时为它生成一个不会与外层名字冲突的新名字\
               ，因此模板内部引入的临时变量不会意外遮蔽使用处的变量。"],
        ["h2", "12.7  声明注解"],
        ["p", "注解写在声明之前，为工具链提供附加信息。它不改语言的语义，但可被编译器、文档工具、测试框\
               架等读取。"],
        ["code", "tie", "
@priority(3)
@deprecated(\"改用 fast_path\")
pub func slow_path(input: i64) -> i64 { ... }
"],
        ["p", "注解可叠加，参数为字面量。把这类信息写成注解而不是注释，是因为注解可以被程序读取——检查工\
               具能据此施加规则，文档工具能据此生成索引，而不只是给人看。"],
        ["h2", "12.8  条件编译"],
        ["p", "同一份源码可能要在不同平台或不同构建配置下产出不同结果。条件编译按编译期已知的条件选择性\
               地纳入一段声明。"],
        ["code", "tie", "
#cfg(os = linux)
pub func path_sep() -> string { return \"/\" }
#else
pub func path_sep() -> string { return \"\\\\\" }
#end
"],
        ["p", "条件的键是编译期已知的一组：os（操作系统）、target（目标平台）、debug / \
               release（构建档）。条件在编译期求值，未选中的分支不参与检查也不进入产物——因此在某一平台\
               上无法通过检查的代码，只要不属于该平台的分支，就不会妨碍编译。这一点与运行期分支有本质区\
               别。"],

        // ===== 第 13 章  所有权与移动 =====
        ["h1", "第 13 章  所有权与移动"],
        ["p", "每个值都有明确的归属。绝大多数时候归属是显然的——值属于声明它的那个变量。当值需要在变量之\
               间转手时，语言要求这件事被写出来，而不是悄悄发生。"],
        ["h2", "13.1  默认按值"],
        ["p", "赋值与传参默认按值：新位置得到一份独立的值，原位置继续有效。两个变量此后互不影响，读写其\
               中一方不会改变另一方。"],
        ["code", "tie", "
var a: i64 = 1
var b = a
b = 2
println(to_string(a))   // 1
"],
        ["p", "按值形参的写入是不可观测的。被调方写入的是自己保有的那一份：函数返回后修改随之消失，调用\
               方手里的值从未改变。写出来像是修改、运行时什么也没有发生——这类沉默不是语言愿意给的，因此\
               对按值表形参的直接写入——下标写入、追加（见 3.11）以及以该形参为接收者的原位操作——在编译\
               期检出为「不可观测写入」。"],
        ["code", "tie", "
func fill(t: table<i64>) {
    table_push(t, 1)   // 错误：不可观测写入（按值形参）
}
"],
        ["p", "要改动调用方的值，把形参声明为 ref——写回原对象正是 ref 的语义（见 \
               13.4）；若希望调用方显式接住修改，也可以让函数返回合并后的新值，由调用方赋回。"],
        ["code", "tie", "
func fill(ref t: table<i64>) {
    table_push(t, 1)   // 写回调用方的表
}

var xs = table_new_i64()
fill(xs)               // xs 变为 [1]
"],
        ["h2", "13.2  显式移动"],
        ["p", "当不需要保留原变量、且希望避免复制开销时，用移动记号把所有权转出。此后原变量处于「已移动\
               」状态。"],
        ["code", "tie", "
var big = collect()
var owned = big        // 复制或转移，按类型语义
consume(owned)
"],
        ["p", "参数声明为 move 时，调用即转移：形参约定本身就表达了「这个值交给被调方」，调用方不必在调\
               用点重写记号。"],
        ["code", "tie", "
func take(move t: table<i64>) -> i64 { return len(t) }

var xs: table<i64> = []
xs <- 1
var n = take(xs)
// 此后 xs 不可再用
"],
        ["h2", "13.3  已移动状态"],
        ["p", "变量被移出之后再次使用会被检出。这条检查覆盖直接读取、再次传入、以及作为表达式的一部分使\
               用。"],
        ["code", "tie", "
var n = take(xs)
println(to_string(len(xs)))    // 错误：变量已移出
"],
        ["p", "检出发生在编译期，因此这类错误不会在运行期以「读到已释放对象」的形式出现。需要保留原值继\
               续使用时不使用移动，改用按值或借用。"],
        ["h2", "13.4  借用与转移的取舍"],
        ["p", "三种做法对应三种需求，选择依据是「调用方还需要这个值吗」。"],
        ["tblw",
            ["需求", "做法"],
            ["调用方不需要继续用", "声明 move，把所有权交给被调方"],
            ["调用方继续用，只读取", "声明 immut，避免复制"],
            ["调用方继续用，且要被调方修改", "声明 ref，写回原对象"],
            ["双方各持一份，互不影响", "按值，接受一次复制"],
            [3000, 6020]],
        ["h2", "13.5  复制与克隆"],
        ["p", "按值传递对小的标量代价为零；对表这类动态结构则是一次真实的数据复制。需要明确表达「我要一\
               个独立的副本」时使用克隆，使复制的成本在代码里可见。"],
        ["code", "tie", "
var snapshot = xs.clone()
"],
        ["note", "可写借用不产生副本，因此能修改原对象；但它有生命周期限制——借用不能被闭包捕获带走（见第 \
                  5 章），也无法越过函数边界长期存在。这组限制共同保证借用指向的对象始终有效。"],

        // ===== 第 14 章  界面元素块与图语法 =====
        ["h1", "第 14 章  界面元素块与图语法"],
        ["p", "有两类结构，用函数调用写出来会显著失去可读性：嵌套很深的界面元素树，以及需要表达拓扑关系\
               的图。语言为二者提供专门的记号，使代码的形态接近它描述的结构本身。"],
        ["h2", "14.1  元素块的写法"],
        ["p", "元素块以 @ 记号引入，块内书写元素与属性。元素之间的嵌套关系由书写的层次表达，不需要括号\
               配对。"],
        ["code", "tie", "
@ window \"设置\" {
    size: 480 x 320
    @ panel {
        @ label \"服务地址\"
        @ input host: \"localhost\"
        @ row {
            @ button \"保存\" on_click: save
            @ button \"取消\" on_click: cancel
        }
    }
}
"],
        ["p", "这段写法与它描述的界面同构：外层窗口包含一个面板，面板包含一行文本、一个输入框与一个按钮\
               行。改结构时改动的位置与视觉上的位置一致。"],
        ["h2", "14.2  属性与绑定"],
        ["p", "元素的属性写在元素之后，形式为名称与值。值可以是字面量、变量或表达式；写表达式时用花括号\
               界定，形式与插值字符串 h\"...\" 中的花括号一致。"],
        ["code", "tie", "
@ label title
@ progress value: done * 100 / total
@ input host: config.host
"],
        ["p", "属性可以分行书写，也可以放在同一行。分行时每个属性独占一行，便于对齐与增删。"],
        ["h2", "14.3  事件"],
        ["p", "事件用 on_事件名 的形式绑定到一个函数值。绑定接受具名函数，也接受短闭包。"],
        ["code", "tie", "
@ button \"重试\" on_click: retry
@ button \"清空\" on_click: t -> clear_all()
@ input host: \"localhost\" on_change: host_changed
"],
        ["p", "事件处理函数是普通函数，参数与返回类型由事件类型决定。由于函数值遵循第 5 \
               章的捕获规则，事件处理只携带值快照，不持有对界面外部状态的可写引用。"],
        ["h2", "14.4  数据与界面"],
        ["p", "界面元素可以引用所在作用域的值。值的更新触发界面刷新，刷新范围由引用关系决定——读取了某个\
               值的元素才会重建，其余部分保持不动。"],
        ["code", "tie", "
func view(state: AppState) -> i64 {
    @ window \"计数器\" {
        @ label \"计数：\" + to_string(state.n)
        @ button \"加一\" on_click: bump
    }
    return 0
}
"],
        ["h2", "14.5  图语法"],
        ["p", "图语法用于描述节点与它们之间的连接。节点声明与边声明分开书写：先给节点起名，再用箭头描述\
               连接方向。"],
        ["code", "tie", "
graph Pipeline {
    node fetch
    node parse
    node store

    fetch -> parse
    parse -> store
    store -> fetch
}
"],
        ["p", "箭头方向即数据或控制流的流向。需要给边附加条件或权重时，在箭头之后书写。"],
        ["code", "tie", "
    parse -> store when valid
    parse -> fetch   when invalid
"],
        ["p", "图作为值可以构造、组合与执行：构造产生图对象，组合把两个图按同名节点连接起来，执行按拓扑\
               顺序推进。由于图是不可变的，组合不会修改原图，而是产生新图——这使得图可以在多个调用点之间\
               安全共享。"],
        ["note", "元素块与图语法都不是独立语言，而是同一套表达式的书写形态。二者内部可以出现普通表达式、函\
                  数调用与闭包，也可以被普通代码构造出来。"],
        ["h2", "14.6  界面单元"],
        ["p", "界面由若干「单元」组成：页面级的视图、可复用的组件、以及样式与主题的声明单元。单元是文件\
               的顶层声明，与函数、结构并列。"],
        ["tblw",
            ["单元", "作用"],
            ["视图", "页面级界面单元。有输入（属性）与输出（动作契约），把外部状态映射为界面结构。"],
            ["组件", "可复用界面单元。与视图同构，额外支持内容插槽，使调用方可以填入子内容。"],
            ["样式", "选择器规则与分层声明。见 14.8。"],
            ["主题", "设计变量的取值表。见 14.8。"],
            ["动作", "交互契约：只声明有哪些交互，不写实现。实现由外部提供。"],
            [2600, 6420]],
        ["p", "把界面写成声明而不是构造调用，目的是让界面结构与它的视觉形态保持同构：嵌套关系由缩进表达\
               ，层次一目了然。"],
        ["code", "tie", "
view Counter(count: i64, history: table<string>) -> (Dec, Inc, Reset) {
    @Column {
        @Text \"计数：\" + to_string(count)

        if count > 2 {
            @Badge \"偏大\"
        }

        for h in history {
            @Text h .muted
        }

        @Row {
            @Button \"-1\" .lg -> Dec
            @Button \"+1\" .lg -> Inc
        }
    }
}
"],
        ["p", "视图的入端口是属性，出端口是动作契约。出端口决定这个视图可以向外部发出哪些交互——使用方据\
               此提供实现，视图本身不关心交互如何被处理。"],
        ["h2", "14.7  元素与控制流"],
        ["p", "元素用 @ 引入，写在界面单元的块内。元素语句之间可以穿插「原生控制流」：条件、遍历与分支\
               直接写在界面里，表达「按条件显示」「按集合重复」——不需要为界面另造一套条件指令。"],
        ["p", "元素的内容形式有两种：字符串字面量可以省略括号，其他表达式保留括号。"],
        ["code", "tie", "
@Text \"直接写字面量\"        // 省略括号
@Text(to_string(count))      // 表达式保留括号
@Text \"计数：\" + to_string(count)
"],
        ["p", "控制流在界面里与在函数里语义完全一致：条件为真才纳入该元素，遍历按集合逐项展开。这种一致\
               性免去了「界面里的条件与代码里的条件规则不同」这类需要额外记忆的地方。"],
        ["h2", "14.8  修饰与事件"],
        ["p", "元素可以带修饰链，用于给出外观与档位。修饰分两类：外观钩子与语义档位。"],
        ["ul", [
            "外观钩子：含义由样式表给出。结构文件里不出现颜色、字号这类具体取值，只出现名字。",
            "语义档位：含义由组件库给出，表示尺寸、密度等结构性选择。",
        ]],
        ["code", "tie", "
@Text \"标题\" .title
@Text \"说明\" .muted
@Button \"+1\" .lg -> Inc
"],
        ["p", "事件用箭头把元素连到动作：箭头右侧是动作名，表示「这个元素被触发时发出该动作」。控制流的\
               流向与数据流的写法一致，因此界面的交互路径与数据变换路径用同一套阅读方式。"],
        ["h3", "分层与作用域"],
        ["p", "样式按层组织，层的先后由声明顺序决定：后声明的层覆盖先声明的层；同层内按书写顺序，后者胜\
               出。语言不做选择器权重计算——同一规则在不同层级的胜负关系一眼可见，不需要推算特异性分数。"],
        ["code", "tie", "
@layer base, components, overrides

@scope Card {
    .title { 前景: 表面色 }
}
"],
        ["p", "主题是一张变量取值表，样式规则引用变量而不写死取值。因此换肤只需换主题，样式规则不动。"],
        ["code", "tie", "
@theme dark {
    表面色 = 深灰900
    强调色 = 蓝400
}
"],
        ["p", "这样的分工使三件事各自独立：结构决定有什么，样式决定长什么样，主题决定用什么色。改动其中\
               一项不影响另外两项。"],

        // ===== 第 15 章  工具链与语言服务 =====
        ["h1", "第 15 章  工具链与语言服务"],
        ["p", "语言规范定义了什么是对的；工具链让书写、检查与维护这件事变得可行。本章说明编译、诊断、格\
               式化与文档生成的行为约定。"],
        ["h2", "15.1  编译流程"],
        ["p", "编译分为若干阶段，每阶段有明确的输入输出，可以对中间产物单独检查。"],
        ["tblw",
