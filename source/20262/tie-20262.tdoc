var q = 2 ** 3 ** 2     // 512   右结合，即 2 ** (3 ** 2)
"],
        ["p", "带检查的幂写作 **?，在结果超出该类型表示范围时报告错误，而不是回绕。数值敏感的计算应使用\
               这一形式。"],
        ["h2", "3.5  带检查的运算"],
        ["p", "加、减、乘、幂与移位各有一个带检查的变体，运算符后接问号。溢出或越界时不再回绕，而是触发\
               可捕获的错误。"],
        ["code", "tie", "
var s = a +? b      // 溢出即报错
var d = a -? b
var m = a *? b
var p = a **? b
var sh = a <<? b    // 移位量越界即报错
"],
        ["p", "同一能力另有函数形态，便于在不希望中断流程处使用：这类函数返回结果与「是否溢出」两个值，\
