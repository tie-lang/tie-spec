// tie 语言语法规范 2026.2 —— 文档源（tdoc）
// 生成：tiec build.tie -o build.exe && build.exe（工作目录 = 仓库根）
//
// 块协议见 tofflib/src/doc/model.tie：每个块是 [类型, 参数…]。
// 代码块用 here-doc 形态：开引号后换行，内容逐字保留（缩进即排版），收尾引号独占一行；
// 长段落用 `\` 续行：换行与缩进都不进入文本。表格列宽单位为 twips（20 twips = 1 pt）。
[
    "title": "tie 语言语法规范",
    "blocks": [
        ["cover", "tie 语言语法规范", "tie Language Specification · 版本 2026.2"],
        ["toc", 2],

        // ===== 第 1 章  词法与记号 =====
        ["h1", "第 1 章  词法与记号"],
        ["p", "本章定义一个 tie 源文件的物理形态：如何组织、如何切分为记号、哪些记号有意义。词法层是其\
               余一切章节的基础——语法分析只看到本章定义的记号流，而不关心源文件的字节细节。"],
        ["h2", "1.1  源文件结构：头部与内容"],
        ["p", "一个 tie 源文件由两部分组成：头部声明本文件是什么，内容承载真正的代码或数据。两者职责分\
               离，头部只占最前面几行。"],
        ["code", "tie", "
type tie<logic>          // 头部：声明文件角色
                        // （其后为内容区）
func main() {
    println(\"hello\")
}
"],
        ["p", "头部是真正的语法行，而不再是以注释形式书写的编译器指令。头部必须位于文件最前若干行，连续\
               排列（其间允许空行），直到第一个非头部行为止。"],
        ["h3", "头部语法"],
        ["p", "头部由关键字 type、语言名 tie 与可选的尖括号子类型构成。子类型写在尖括号内；带参数的角色\
               再用冒号给出参数，多个修饰用逗号分隔。"],
        ["code", "tie", "
type tie                       // 裸形式：Type 角色本身
type tie<logic>                // 带子类型的完整形式
type tie<db: vector, unsafe>   // 带参数与修饰
"],
        ["p", "若文件未声明头部，按 logic 处理。文件名可以采用 xxx.角色.tie \
               的形式声明默认角色；当文件名与头部声明不一致时，以头部为准并给出一条警告。这样既允许用文\
               件名快速辨别用途，又不让文件名凌驾于显式声明之上。"],
        ["h2", "1.2  文件角色"],
        ["p", "角色决定编译器如何解析与生成该文件。它是文件的第一属性，决定了后续内容允许出现什么构造。"],
        ["tblw",
            ["头部", "角色与允许的内容"],
            ["type tie<logic>", "逻辑代码。可含函数、结构、模块级声明；可编译为可执行程序或静态库。默认角色。"],
            ["type tie<class>", "类库文件。与逻辑代码同为可执行语义，但只编译为静态库，不产生入口。"],
            ["type tie<tsc>", "脚本。顶层语句按书写顺序直接执行，不要求显式入口。"],
            ["type tie<data>", "纯数据。只允许数据声明与字面量，不允许函数体；可被其他文件导入作为常量源。"],
            ["type tie<ui>", "界面文件。声明界面单元树与交互契约，由编译器生成界面代码（见第 14 章）。"],
            ["type tie<db>", "数据库文件。声明表结构与查询，编译器生成建表与读写代码。"],
            ["type tie<port>", "接口文件。声明对外契约，不含实现。"],
            ["type tie<ir>", "中间表示文件。直接产出中间代码，不再经过后续优化与链接阶段。"],
            ["type tie<test>", "测试文件。只做检查与执行，不产出交付物。"],
            ["type tie<bench>", "基准文件。用于性能测量。"],
            ["type tie<zd>", "结构化二进制数据文件——数据格式的二进制变体（见第 9 章）。"],
            ["type tie<tsh>", "终端脚本文件，由终端脚本宿主执行（见第 15 章）。"],
            [2400, 6620]],
        ["h3", "修饰角色"],
        ["p", "修饰角色与基础角色并列书写，用于收紧或放宽该文件的语义边界。"],
        ["tblw",
            ["修饰", "作用"],
            ["unsafe", "整个文件处于不安全上下文。用于平台桥接与外部接口封装这类必须直接操作内存的模块。"],
            ["owned", "声明该文件的依赖归本项目所有（非外部依赖）。"],
            ["embedded", "目标为嵌入式场景，约束可用特性与运行时设施。"],
            [2400, 6620]],
        ["p", "角色集是开放的：项目可以在自己的角色注册文件里声明自定义角色，使工程可以按领域细分文件的\
               编译策略。"],
        ["note", "角色不是注释、不是标记，而是编译器分派解析与生成策略的依据。这正是头部必须在最前面、且被\
                  词法层正式识别的原因。"],
        ["h2", "1.3  字符集与编码"],
        ["p", "源文件以 UTF-8 编码。字符串内部同样以 UTF-8 存储，但语言层面区分两个尺度："],
        ["ul", [
            "s.len() / s.char(i) —— 以码点为单位。中文、emoji 都算一个。",
            "len(s) —— 以字节为单位。一个汉字占 3 字节。",
        ]],
        ["p", "遍历文本一律使用码点尺度；按字节遍历会把多字节字符切碎。这一约定贯穿标准库的文本处理函数\
               。"],
        ["code", "tie", "
var s = \"你好\"
s.len()       // 2   码点
len(s)           // 6   字节
s.char(0)   // \"你\"
"],
        ["h2", "1.4  注释"],
        ["p", "注释有三种形态，前两种在词法阶段被丢弃，不进入记号流；第三种会附着到声明上。"],
        ["code", "tie", "
// 行注释：自 // 起至本行结束
/* 块注释：可跨行 */
/// 文档注释：附着到紧随其后的声明
"],
        ["p", "文档注释可被工具提取，用于生成接口文档。它比普通注释有更强的归属语义：紧接在某个声明之前\
               ，就属于那个声明；写在函数体内部则退化为普通注释。"],
        ["h2", "1.5  标识符"],
        ["p", "标识符由字母、下划线或 Unicode 字母开头，其后可接字母、数字与下划线。语言接受 Unicode \
               标识符，中文可以直接用作标识符。"],
        ["code", "tie", "
count, _tmp, 用户数, 结果1
"],
        ["p", "约定：类型名以大写字母开头，函数与变量以小写字母或下划线开头。这是约定而非强制，编译器不\
               做检查，但工具链会据此提供提示。"],
        ["h2", "1.6  关键字"],
        ["p", "关键字是保留字，不可用作标识符。它们按用途分组如下。"],
        ["tblw",
            ["用途", "关键字"],
            ["声明", "var const func struct enum namespace port interface impl import as pub using extern macro alias actor extends"],
            ["类型", "i8 i16 i32 i64 u8 u16 u32 u64 i128 u128 f32 f64 bool trit char string void code table map num text misc any"],
            ["语句", "if else while for in switch case default when break continue return yield goto"],
            ["修饰与更新", "ref immut move deep shared inline repr unsafe const async with reentrant"],
            ["表达式", "is await"],
            ["字面量", "true false zero"],
            ["并发与故障", "panic"],
            ["内联汇编", "asm"],
            [2600, 6420]],
        ["note", "关键字表是封闭的：新关键字只在语言版本升级时加入。语言另有一批只在特定位置被识别的词（见 \
                  1.13），它们不是保留字，但同样不宜用作标识符。"],
        ["h2", "1.7  数值字面量"],
        ["p", "整数支持五种进制，允许用下划线分组以提高可读性。小数与指数形式构成浮点字面量。字面量可带\
               类型后缀，显式指定其类型。"],
        ["tblw",
            ["形态", "含义"],
            ["42", "十进制整数，默认类型 i64"],
            ["0xFF / 0xff", "十六进制"],
            ["0b1011", "二进制"],
            ["0o755", "八进制"],
            ["0t1T0", "平衡三进制（数字 0 / 1 / T，T 表示 -1）"],
            ["1_000_000", "下划线分组，等价于 1000000"],
            ["0xCA_FE", "分组在各进制中均可"],
            ["3.14 / 1.5e3", "浮点，默认类型 f64"],
            ["1.2f32 / 42i32 / 0x80u16", "带类型后缀，显式指定类型"],
            ["-1t / 0t / 1t", "三值字面量（等价于 false / zero / true）"],
            [3400, 5620]],
        ["h2", "1.8  布尔与三值字面量"],
        ["p", "true 与 false 构成布尔类型。语言另有一个三值类型 trit，取值为正、零、负，其字面量复用 \
               true / zero / false，在 trit 上下文中适配为三值。"],
        ["code", "tie", "
var b: bool = true
var p: trit = true     // 正
var z: trit = zero     // 零
var n: trit = false    // 负
"],
        ["h2", "1.9  字符与字符串字面量"],
        ["p", "字符字面量以单引号界定，字符串字面量以双引号界定。字符串有四种形态，各有其适用场合。四种\
               形态里只有插值字符串会求值花括号内的表达式，而它必须以 h \
               前缀显式标出——花括号是否被当作替换点，看字面量的头一个字符就知道。"],
        ["tblw",
            ["形态", "适用场合"],
            ["普通字符串 \"...\"", "转义生效；花括号原样保留。日常使用。"],
            ["原始字符串 r\"...\"", "转义不生效、无插值。写路径、正则、含反斜杠的内容用它，省去双重转义。"],
            ["多行字符串 \"\"\"...\"\"\"", "可跨行书写，按闭合引号的缩进剥离每行前缀。写 SQL、JSON、模板片段用它，不破坏源码缩进。"],
            ["插值字符串 h\"...{e}...\"", "花括号内表达式求值后转为文本拼入；跨行时写作 h\"\"\"...\"\"\"，同样带插值。"],
            [3300, 5720]],
        ["code", "tie", "
var c: char = 'A'
var esc = \"tab:\\t quote:\\\" backslash:\\\\\"
var raw = r\"C:\\path\\to\\file\"        // 无转义，原样保留
var plain = \"共 {n} 项\"              // 花括号原样保留
var interp = h\"共 {n} 项\"            // 花括号内求值后拼入
"],
        ["p", "多行字符串按闭合引号所在行的缩进作基准，逐行剥离该前缀。这样源码可以在任何缩进层级书写 \
               SQL 或 JSON 片段，而字符串内容本身保持左对齐。"],
        ["p", "插值是显式开启的行为，不是普通字符串的隐含语义。含花括号的内容——JSON、模板片段、正则——因\
               此可以照原样书写，不必担心被意外求值；确实要把运行时值拼进去时，才在引号前写上 h。h \
               不能与形态前缀 r 组合：原始字符串的用途正是「一个记号也不解释」，而 h 要求解释花括号。"],
        ["p", "插值字符串里要写出字面的花括号时，写两个花括号代表一个；不带 h \
               的字符串没有这条规则，花括号即字面量。"],
        ["p", "插值点可以携带格式说明符，写在表达式之后、以冒号分隔：花括号内写作「表达式:规格」。规格\
               自左向右依次是对齐与填充、正负号、宽度、精度与类型，各段均可省略。有了它，数值的定点、补\
               零、进制转换这类日常格式化就在插值里一并完成，不再需要单独的格式化函数族。"],
        ["tblw",
            ["规格段", "含义"],
            ["对齐与填充", "< 左对齐、^ 居中、> 右对齐；可在其前写一个填充字符，默认空格。"],
            ["符号", "+ 表示非负数也显式写出加号。"],
            ["宽度", "十进制整数，最小字符数，不足按对齐补齐。"],
            ["精度", ".n：浮点限定小数位，字符串限定最大长度。"],
            ["类型", "b 二进制、o 八进制、x 十六进制、e 科学计数、f 定点、% 百分比。"],
            [3400, 5620]],
        ["code", "tie", "
h\"{x:08.2f}\"          // 定点两位小数，宽八，不足补零
h\"{id:>6x}\"            // 十六进制，右对齐，宽六
h\"{ratio:%}\"           // 百分比
h\"{name:^10}\"          // 字符串居中，宽十
"],
        ["h2", "1.10  自动分号"],
        ["p", "tie 不要求每条语句以分号结尾。编译器在词法阶段按规则补全语句结束，这一机制称为自动分号插\
               入。"],
        ["ul", [
            "当一行结束后，若下一个记号不能延续当前语句，则在此处插入语句结束。",
            "当一行以逗号、二元运算符、左括号等「明显未结束」的记号结尾时，不插入。",
            "显式书写分号始终合法，可与自动补全混用。",
            "括号深度只统计圆括号与方括号；花括号是块边界，不计入。",
            "注释、字符串、插值块内部不参与该判定。",
        ]],
        ["p", "这条规则让代码更接近日常书写的文本，同时保持分析的确定性——判定只看记号，不依赖缩进或换行\
               风格。"],
        ["h2", "1.11  行续行"],
        ["p", "行尾写反斜杠表示「本行未结束」，下一行继续同一语句。它用于把长表达式拆成多行，且不依赖运\
               算符的位置。"],
        ["code", "tie", "
var total = first + \\
    second + \\
    third
"],
        ["p", "自动分号与续行是互补的两条规则：前者在语句该结束时补上结束符，后者明确表示此处不该结束。\
               需要跨行书写的长表达式应当显式续行，而不依赖「行尾恰好是运算符」这一间接判据。"],
        ["h2", "1.12  运算符记号"],
        ["p", "下表汇总全部运算符记号；含义与结合性见第 3 章，第 8 章给出记号一览与优先级表。"],
        ["tblw",
            ["记号", "用途"],
            ["+  -  *  /  %", "算术；取余"],
            ["\\  %%", "整除；成对取余"],
            ["**  **?", "幂；带检查的幂"],
            ["+?  -?  *?  <<?", "带检查的加、减、乘与移位"],
            ["==  !=  <  >  <=  >=", "比较（支持链式比较）"],
            ["&&  ||  !", "逻辑（对三值为三值逻辑）"],
            ["&  |  ^  <<  >>  ~", "位运算"],
            ["=  +=  -=  *=  /=  %=  %%=", "赋值与复合赋值"],
            ["\\=  &=  |=  ^=  <<=  >>=", "其余复合赋值"],
            ["++  --", "自增与自减"],
            ["->", "数据流管道；返回位；短闭包；分支臂"],
            ["<-", "数据流反向赋值；反向解构"],
            ["in  not in", "成员判定与取反"],
            ["?:", "安全默认值"],
            ["?  ?.  ?[", "存在判定与可空链访问"],
            ["\\", "解引用（不安全上下文）"],
            ["..  ..=", "范围（左闭右开 / 左闭右闭）"],
            ["...", "变长形参、实参展开、解构剩余"],
            ["@  #  $  `", "元素标记与注解、属性与标签、宏插值、准引用"],
            ["with", "不可变更新"],
            ["-|  <-|  ->x  ~x  -><", "图的边与节点操作（不安全上下文）"],
            [3400, 5620]],
        ["h2", "1.13  上下文关键字"],
        ["p", "有一类词只在特定位置被识别为语法成分，其他位置是普通标识符。它们不计入保留字，但书写时不\
               应作为变量名使用。"],
        ["tblw",
            ["词", "识别位置"],
            ["fn", "函数类型与函数修饰位置"],
            ["let", "条件解构位置"],
            ["not", "与 in 组合成成员取反"],
            ["try", "错误聚合块位置"],
            ["defer", "作用域收尾块位置"],
            ["guard", "前置条件位置"],
            ["run", "建立并发执行体的位置"],
            ["self", "接收者位置"],
            ["out / inout / target", "内联汇编操作数位置"],
            ["array", "定长数组类型位置"],
            ["r", "紧跟引号时表示原始字符串"],
            ["h", "紧跟引号时表示插值字符串"],
            ["type", "文件头部声明角色"],
            [3000, 6020]],
        ["note", "把这批词与保留字分开列出，是因为二者的约束强度不同：保留字是硬约束（用作标识符即报错），\
                  上下文关键字是命名建议（用作标识符不报错，但在相应位置会产生歧义）。"],

        // ===== 第 2 章  类型系统 =====
        ["h1", "第 2 章  类型系统"],
        ["p", "tie 是静态类型语言：每个表达式在编译期有确定的类型，类型错误在编译期报告，不进入运行期。\
               类型系统同时承担两件事——描述数据的形状，以及表达访问权限（谁可以写、谁只能读、谁拥有所有\
               权）。后者见第 5 章与第 13 章。"],
        ["p", "类型分为若干族：基本类型、复合类型（表、元组、映射）、聚合类型（结构、枚举）、函数与接口\
               类型、以及两种特殊类型（宽类型与动态类型）。"],
        ["h2", "2.1  基本类型"],
        ["p", "基本类型直接对应机器表示，没有隐藏的分配与间接层。"],
        ["tblw",
            ["类型", "含义"],
            ["i8 i16 i32 i64", "有符号整数，宽度以位计"],
            ["u8 u16 u32 u64", "无符号整数"],
            ["i128 u128", "128 位整数"],
            ["f32 f64", "浮点数"],
            ["bool", "布尔，取值 true / false"],
            ["trit", "平衡三进制，取值正 / 零 / 负（见 2.2）"],
            ["char", "单个字符，按码点计"],
            ["string", "不可变文本，UTF-8 存储"],
            ["void", "无值，仅作函数返回类型"],
            ["code", "编译期代码片段，无运行期实体（见第 12 章）"],
            [3200, 5820]],
        ["p", "整数默认类型为 i64，浮点默认类型为 f64。字面量在需要的上下文中会按目标类型调整。"],
        ["h2", "2.2  平衡三进制 trit"],
        ["p", "trit 是一个三值类型，取值正、零、负。它用于三路比较、三值逻辑与平衡三进制数论。与布尔相\
               比，它多了一个「未知」状态，因此比两者择一更贴近真实判定。"],
        ["code", "tie", "
var cmp: trit = compare(a, b)   // 正 表示 a>b，零 表示相等，负 表示 a<b
if cmp == zero {
    // 相等分支
}
"],
        ["p", "三值逻辑的运算规则与布尔一致地推广：与运算取小、或运算取大、非运算取反。混合 trit \
               与整数的运算按提升规则转为整数，除法与取余对 trit 不开放。"],
        ["h2", "2.3  宽类型"],
        ["p", "宽类型是一组类型的类别名，用于在书写时省略具体宽度，或在多种数值类型间统一处理。它只存在\
               于编译期：变量在参与运算时使用推导出的具体类型。"],
