type tie<logic>
// build.tie —— 《tie 语言语法规范 2026.2》构建入口
// ============================================================
// 正文是 tdoc 文档源（tofflib 的统一输入格式）：封面、目录、分章、代码块、
// 表格、脚注都写在 tie-20262.tdoc 里。本文件只做两件事：
//   ① 用门面 load_file 把文档源装载成块流；
//   ② 交给门面渲染 PDF（目录页码由渲染层两遍排版回填），并做生成后结构自检。
//
// 生成：tiec build.tie -o build.exe && build.exe（工作目录 = 仓库根）
// 编排：make.tsh.tie（tshell）
import "../../../tofflib/src/tofflib.tie" as tl
import "../../../tofflib/src/doc/pdfdoc.tie" as pdoc   // 仅用于生成后的 PDF 结构自检

const OUT: string = "tie-20262.pdf";
// 文档源：仓库根运行时走版本化路径；在源码目录内运行时退回同名文件。
const SRC_AT_ROOT: string = "source/20262/tie-20262.tdoc";
const SRC_AT_CWD: string = "tie-20262.tdoc";
// 字体路径相对仓库根（构建脚本以仓库根为工作目录）。
const SPEC_FONT_BODY: string = "C:/Windows/Fonts/NotoSansSC-VF.ttf";
const SPEC_FONT_MONO: string = "fonts/JetBrainsMono-Regular.ttf";

func main() -> i64 {
    var src = SRC_AT_ROOT
    if !file_exists(src) {
        src = SRC_AT_CWD
    }
    var doc: table<string> = table_new_string()
    var ld = tl.load_file(src, doc)
    if str_len(ld) > 0 {
        println("load    = FAILED (" + src + ") " + ld)
        return 1
    }
    println("source  = " + src + " (" + to_string(len(doc)) + " tokens)")

    var ok = tl.pdf(OUT, doc, SPEC_FONT_BODY, SPEC_FONT_MONO)
    println("write = " + to_string(ok))
    if !ok {
        return 1
    }
    println("pages = " + to_string(pdoc.cur_page()))

    // ---------- 生成后自检（五层）----------
    var vr = pdoc.verify(OUT)
    if vr == 0 {
        println("verify  = OK (" + to_string(pdoc.verify_entries()) + " object entries)")
    } else {
        println("verify  = FAILED (code " + to_string(vr) + ")")
        return 1
    }
    var obr = pdoc.verify_objects(OUT)
    if obr == 0 {
        println("objects = OK (" + to_string(pdoc.verify_objs()) + " objects well-formed)")
    } else {
        println("objects = FAILED (code " + to_string(obr) + ")")
        return 1
    }
    var cr = pdoc.verify_content(OUT)
    if cr == 0 {
        println("content = OK (" + to_string(pdoc.verify_gids()) + " glyphs used, notdef " + to_string(pdoc.verify_notdef()) + ")")
    } else {
        println("content = FAILED (code " + to_string(cr) + ")")
        return 1
    }
    var lr = pdoc.verify_layout(595, 842)
    if lr == 0 {
        println("layout  = OK (" + to_string(pdoc.verify_segs()) + " text segments in bounds)")
    } else {
        println("layout  = FAILED (code " + to_string(lr) + ")")
        return 1
    }
    var orc = pdoc.verify_outlines()
    if orc == 0 {
        println("outline = OK (" + to_string(pdoc.verify_checked()) + " glyphs checked, " + to_string(pdoc.verify_empty()) + " blank)")
    } else {
        println("outline = FAILED (code " + to_string(orc) + ")")
        return 1
    }
    println("fonts   = " + to_string(pdoc.font_count()) + " (0.body " + to_string(pdoc.used_count(0)) +
        " glyphs, 1.mono " + to_string(pdoc.used_count(1)) + " glyphs)")
    return 0
}
